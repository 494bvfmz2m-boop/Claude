# Bot token from Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# ID of the forum channel where DMs get posted (right-click channel -> Copy Channel ID)
DM_CHANNEL_ID=
# Optional: only members with this role can reply and use the buttons. Empty = anyone who can see the forum.
STAFF_ROLE_ID=
# Optional: role pinged when a new conversation starts or a closed one reopens
PING_ROLE_ID=
# Optional: automatic DM sent when someone starts (or reopens) a conversation. Use \n for new lines.
AUTO_REPLY=
# Optional: true = replies are sent without your name. Default shows "**YourName:** message".
ANONYMOUS_REPLIES=
# Optional: timezone for "busiest hours" in stats, e.g. Europe/Amsterdam. Default UTC.
TIMEZONE=
