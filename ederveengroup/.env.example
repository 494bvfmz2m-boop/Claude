# Everything here is optional. Copy this file to .env to change a setting.

# Port the web server listens on
# PORT=3000

# Secret used to encrypt session cookies. Leave it unset and a strong random key is
# generated automatically in data/session.key (keep that file to keep people signed in).
# SESSION_SECRET=

# Cookies are marked Secure automatically on HTTPS requests; set true to force it always
# SECURE_COOKIES=true

# Which reverse proxy to trust for the client IP and https. Default: one on this machine
# (loopback). Coolify/Traefik or one proxy in another container: 1. Cloudflare + Coolify: 2.
# TRUST_PROXY=1

# Where settings, signatures and contacts are stored
# DATA_DIR=./data

# Mail servers (defaults are Purelymail)
# IMAP_HOST=imap.purelymail.com
# IMAP_PORT=993
# SMTP_HOST=smtp.purelymail.com
# SMTP_PORT=465

# Where the webmail lives on your domain (default /mail). Use / to serve it at the root
# instead of the Work in Progress page.
# BASE_PATH=/mail

# Auto edit in the Photo and Video Editors (admins only). Usually pasted in Admin → AI
# instead; a key set here wins over that one. Claude is the default; pick the service in Admin → AI.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# Any other OpenAI-compatible service (Together, DeepSeek, Ollama…):
# AI_API_KEY=
# AI_BASE_URL=https://api.example.com/v1
