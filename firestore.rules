rules_version = '2';

// Beveiliging van de online opslag. Plak dit in Firebase → Firestore Database → Regels.
// - Iedereen mag de teksten van de site lezen (de site zelf haalt ze op).
// - Alleen de hoofdbeheerder en uitgenodigde beheerders mogen ze aanpassen.
// - Alleen de hoofdbeheerder mag beheerders uitnodigen en verwijderen.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return signedIn() && myEmail() == '622521@nxt.eu';
    }
    function isAdmin() {
      return isOwner() || (verified() && exists(/databases/$(database)/documents/admins/$(myEmail())));
    }

    match /site/content {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['json', 'updated', 'updatedBy'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.updatedBy == myEmail();
    }

    match /admins/{email} {
      allow read: if isAdmin() || (verified() && email == myEmail());
      allow create: if isOwner()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.status == 'invited';
      allow update: if isOwner()
        || (verified() && email == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'activatedAt'])
            && request.resource.data.status == 'active');
      allow delete: if isOwner();
    }
  }
}
