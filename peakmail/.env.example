# Port the web server listens on
PORT=3000

# Secret used to encrypt session cookies. Set this in production so sessions
# survive redeploys; if unset, a random key is generated in DATA_DIR/session.key.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true when served over HTTPS (on automatically when NODE_ENV=production)
SECURE_COOKIES=false

# Set when running behind a reverse proxy (e.g. 1 for nginx/Caddy/Cloudflare)
# so login rate limiting sees real client IPs
TRUST_PROXY=

# Where settings, signatures and contacts are stored
DATA_DIR=./data

# Mail servers (defaults are Purelymail)
IMAP_HOST=imap.purelymail.com
IMAP_PORT=993
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
