# Discord bot credentials (Discord Developer Portal -> your application)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set for instant slash-command registration to one server while
# developing. Leave blank to register commands globally (~1 hour to propagate).
DISCORD_GUILD_ID=

# Discord OAuth (dashboard login) — same application as above.
# Client Secret: Developer Portal -> your app -> OAuth2 -> Client Secret.
# Redirect URI must be added there too, under OAuth2 -> Redirects, and must
# match this value exactly (protocol, host, and path).
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Comma-separated Discord user IDs that can manage every server the bot is
# in, regardless of their permissions in each individual server. Optional.
SUPER_ADMIN_DISCORD_IDS=

# Web dashboard
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Matching sensitivity (optional tuning, see README)
MATCH_MIN_OVERLAP=1
MATCH_MIN_RATIO=0.3

# SQLite database file location
DATABASE_FILE=./data/bot.sqlite3
