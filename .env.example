# ---- Discord bot ----
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
# Optional: set to a guild id while developing for instant (non-cached) slash command updates.
# Leave blank to register commands globally (takes up to ~1 hour to propagate).
GUILD_ID=

# ---- Database ----
DATABASE_PATH=./data/bot.sqlite

# ---- Dashboard ----
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
# Generate with: npm run hash-password -- "your-new-password"
DASHBOARD_ADMIN_USERNAME=Admin
DASHBOARD_ADMIN_PASSWORD_HASH=
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Set to "production" when served over HTTPS (behind a reverse proxy). Enables secure cookies.
NODE_ENV=development

# ---- Automatic order embeds: pick ONE of the two options below (or both) ----

# Option A — a custom website/backend POSTs JSON to
# POST /api/webhook/order/:guildId with header "x-webhook-secret" matching this value.
# Body: { "order_ref": "...", "product": "...", "customer": "...", "amount": "...", "status": "received" }
ORDER_WEBHOOK_SECRET=

# Option B — Stripe. Create a webhook endpoint in the Stripe Dashboard pointing at
# https://your-dashboard-domain/api/webhook/stripe/:guildId (use your real Discord
# server ID in place of :guildId), subscribed to "checkout.session.completed"
# and/or "payment_intent.succeeded". Paste the endpoint's signing secret here.
STRIPE_WEBHOOK_SECRET=
# Optional: only needed if you later extend stripeWebhook.js to call the Stripe API
# (e.g. to fetch line items for a Checkout Session). Not required for the webhook itself.
STRIPE_SECRET_KEY=
