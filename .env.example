# Discord bot credentials (Discord Developer Portal -> your application)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set for instant command registration to one server while developing.
# Leave blank to register commands globally (takes up to ~1 hour to propagate).
DISCORD_GUILD_ID=

# Web dashboard
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
DASHBOARD_USERNAME=admin
# Generate with: npm run hash-password
DASHBOARD_PASSWORD_HASH=

# Matching sensitivity (optional tuning, see README)
MATCH_MIN_OVERLAP=1
MATCH_MIN_RATIO=0.3

# SQLite database file location
DATABASE_FILE=./data/bot.sqlite3
