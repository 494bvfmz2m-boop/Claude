# Discord bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Discord application/client ID (Developer Portal -> General Information -> Application ID)
DISCORD_CLIENT_ID=

# --- Discord login (the only way into the dashboard) ---
# Client Secret: Developer Portal -> OAuth2 -> Client Secret (click "Reset Secret" to reveal)
DISCORD_CLIENT_SECRET=
#
# This dashboard's own public URL, no trailing slash (e.g. https://tickets.example.com).
# Must exactly match a Redirect URI you add in Developer Portal -> OAuth2 -> Redirects,
# with /auth/discord/callback appended (the app appends that part automatically here).
DASHBOARD_URL=

# --- Optional: closed beta ---
# Your own Discord user ID (Discord -> User Settings -> Advanced -> Developer Mode,
# then right-click your own name -> Copy User ID). Whoever logs in with this ID gets
# an "Admin" link to /admin, where they can flip on closed-beta mode and manage which
# other Discord user IDs are allowed to log in. Leave blank to skip this entirely --
# nobody gets locked out and there's no admin panel.
OWNER_DISCORD_ID=

# Shown to anyone turned away by closed beta: "Ask <this> on Discord to add you."
BETA_CONTACT_HANDLE=spontanedonder

# Random long random string used to sign dashboard session cookies. Change this.
SESSION_SECRET=change-this-too-please

# Port the web dashboard listens on
PORT=3000

# Set to "true" once the dashboard is served over HTTPS (e.g. behind Coolify's proxy
# with a domain + Let's Encrypt cert). Keep "false" while accessing it via raw http://IP.
COOKIE_SECURE=false

# --- Optional: Custom bot (Custom Tebex tier) ---
# Required only if you want to let subscribers on a tier with the "custom_bot" feature
# upload their own Discord bot token to run under their own branding. Encrypts every
# stored token at rest -- 32 random bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/changing this key makes every already-stored custom bot token unrecoverable
# (they'd need to re-upload). Leave blank to disable the feature entirely.
TOKEN_ENCRYPTION_KEY=
