# Copy to .env.local for local dev, or set these as environment variables
# in Coolify's "Environment Variables" tab for production.

# Random string, at least 16 characters — used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# The two accounts that can log in. Both see and can edit all projects
# (this is a small shared tool, not a multi-tenant app).
AUTH_USER_1=alice
AUTH_PASS_1=change-me
AUTH_USER_2=bob
AUTH_PASS_2=change-me-too
