# Password used to log into this dashboard. Change this.
ADMIN_PASSWORD=change-me

# Random long random string used to sign session cookies. Change this.
SESSION_SECRET=change-this-too-please

# Port the dashboard listens on
PORT=3000

# Set to "true" once this is served over HTTPS (e.g. behind Coolify's proxy
# with a domain + Let's Encrypt cert). Keep "false" while accessing it via raw http://IP.
COOKIE_SECURE=false
