# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID of your bot, from the same Developer Portal page
CLIENT_ID=

# Optional: register slash commands to a single guild instead of globally.
# Guild registration updates instantly; global registration can take up to an hour.
# Leave empty in production so the bot works in every server it's added to.
GUILD_ID=

# Discord user ID that reminders are DMed to. Defaults to 1227918600753512480 if unset.
OWNER_ID=1227918600753512480

# Where the JSON database file is stored. Point this at your persistent volume in Coolify.
DB_PATH=./data/reminders.json
