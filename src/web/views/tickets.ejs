<%- include('partials/header', { title: 'Tickets', guild }) %>
<h1>Tickets</h1>
<p class="subtitle">Set up ticket categories, post panels, and see what's open.</p>

<%
  var checklistIncomplete = setupChecklist.some(function (item) { return !item.done; });
  var subnavSections = [];
  if (checklistIncomplete) subnavSections.push({ id: 'checklist', label: 'Setup checklist' });
  subnavSections.push({ id: 'ticket-types', label: 'Ticket types' });
  subnavSections.push({ id: 'panels', label: 'Panels' });
  subnavSections.push({ id: 'recent-tickets', label: 'Recent tickets' });
%>
<%- include('partials/subnav', { sections: subnavSections }) %>

<% if (checklistIncomplete) { %>
  <div class="card" id="checklist">
    <h2>Setup checklist</h2>
    <p class="hint" style="margin-bottom:14px;">Nothing here is required — just what's worth doing before people start using this server.</p>
    <ul class="list">
      <% setupChecklist.forEach(item => { %>
        <li class="list-item">
          <div style="display:flex; align-items:flex-start; gap:10px;">
            <span class="check-dot <%= item.done ? 'done' : '' %>" aria-hidden="true"></span>
            <div>
              <div class="list-item-title"><%= item.label %></div>
              <div class="list-item-meta"><%= item.desc %></div>
            </div>
          </div>
          <% if (!item.done) { %>
            <div class="actions">
              <a class="btn btn-sm btn-ghost" href="<%= item.href %>">Go</a>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div class="card" id="ticket-types">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h2>Ticket types</h2>
    <a class="btn btn-sm" href="/dashboard/<%= guild.id %>/ticket-types/new">+ New ticket type</a>
  </div>
  <% if (ticketTypes.length === 0) { %>
    <p class="empty">No ticket types yet. Create one (e.g. "General Support", "Billing") — it defines which category channel tickets go in, which roles get pinged, and the welcome message.</p>
  <% } else { %>
    <ul class="list">
      <% ticketTypes.forEach(t => { %>
        <li class="list-item">
          <div>
            <div class="list-item-title"><%= t.emoji ? t.emoji + ' ' : '' %><%= t.name %></div>
            <div class="list-item-meta"><%= t.support_role_ids.length %> support role(s) · max <%= t.max_open_per_user %> open per user</div>
          </div>
          <div class="actions">
            <a class="btn btn-sm btn-ghost" href="/dashboard/<%= guild.id %>/ticket-types/<%= t.id %>/edit">Edit</a>
            <form method="post" action="/dashboard/<%= guild.id %>/ticket-types/<%= t.id %>/delete" onsubmit="return confirm('Delete this ticket type? Panels referencing it will stop offering it.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-danger" type="submit">Delete</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<div class="card" id="panels">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h2>Panels</h2>
    <a class="btn btn-sm" href="/dashboard/<%= guild.id %>/panels/new">+ New panel</a>
  </div>
  <p class="hint" style="margin-bottom:12px;">A panel is the message with the button/dropdown users click to open a ticket.</p>
  <% if (panels.length === 0) { %>
    <p class="empty">No panels yet.</p>
  <% } else { %>
    <ul class="list">
      <% panels.forEach(p => { %>
        <li class="list-item">
          <div>
            <div class="list-item-title"><%= p.title %></div>
            <div class="list-item-meta">
              <%= p.ticket_type_ids.length %> ticket type(s) ·
              <% if (p.channel_id) { %>posted in #<%= (guild.channels.cache.get(p.channel_id) || {}).name || 'unknown-channel' %><% } else { %>not posted yet<% } %>
            </div>
          </div>
          <div class="actions">
            <a class="btn btn-sm btn-ghost" href="/dashboard/<%= guild.id %>/panels/<%= p.id %>/edit">Edit / Post</a>
            <form method="post" action="/dashboard/<%= guild.id %>/panels/<%= p.id %>/delete" onsubmit="return confirm('Delete this panel? This does not remove the posted Discord message.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-danger" type="submit">Delete</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<div class="card" id="recent-tickets">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h2>Recent tickets</h2>
    <% if (recentTickets.some(t => t.status === 'closed')) { %>
      <form method="post" action="/dashboard/<%= guild.id %>/tickets/clear-history" onsubmit="return confirm('Clear all closed tickets from this history? Open/claimed tickets are kept. This only removes the list here, not the transcripts already posted to your transcript channel.');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm btn-danger" type="submit">Clear history</button>
      </form>
    <% } %>
  </div>
  <% if (recentTickets.length === 0) { %>
    <p class="empty">No tickets yet.</p>
  <% } else { %>
    <ul class="list">
      <% recentTickets.forEach(t => { %>
        <li class="list-item">
          <div>
            <div class="list-item-title">#<%= t.id %> · opened by user ID <%= t.opener_id %></div>
            <div class="list-item-meta"><%= new Date(t.created_at + 'Z').toLocaleString() %><% if (t.closed_at) { %> · closed <%= new Date(t.closed_at + 'Z').toLocaleString() %><% } %></div>
          </div>
          <span class="badge badge-<%= t.status %>"><%= t.status %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
<%- include('partials/footer') %>
