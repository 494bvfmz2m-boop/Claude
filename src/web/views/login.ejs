<%- include('partials/header', { title: 'Login', hideLogout: true }) %>
<div class="login-wrap">
  <h1>Quellum</h1>
  <p class="subtitle">Log in to manage tickets, moderation, embeds and settings.</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <div class="card" style="padding:24px;">
    <a class="btn" href="/auth/discord" style="width:100%; justify-content:center;">Log in with Discord</a>
    <p class="hint" style="text-align:center; margin-top:12px;">
      You'll only see and manage servers where you're the owner or have Manage Server.
    </p>
  </div>
</div>
<%- include('partials/footer') %>
