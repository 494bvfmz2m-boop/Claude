<%- include('partials/header', { title: 'Roles', guild }) %>
<a href="/dashboard/<%= guild.id %>/settings" class="btn btn-ghost btn-sm" style="margin-bottom:16px;">&larr; Settings</a>
<h1>Roles</h1>
<p class="subtitle">The ticket-banned role, the role new members get automatically, and rules that react to role changes.</p>

<% if (notice) { %>
  <div class="<%= notice.ok ? 'card' : 'error' %>" style="<%= notice.ok ? 'border-color:var(--success); margin-bottom:20px;' : 'margin-bottom:20px;' %>">
    <%= notice.text %>
  </div>
<% } %>

<form class="card" method="post" action="/dashboard/<%= guild.id %>/settings/roles">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <label for="ticketBannedRoleId">Ticket-banned role</label>
  <select id="ticketBannedRoleId" name="ticketBannedRoleId">
    <option value="">— None (no one is blocked from opening tickets) —</option>
    <% options.roles.forEach(r => { %>
      <option value="<%= r.id %>" <%= settings.ticket_banned_role_id === r.id ? 'selected' : '' %>><%= r.name %></option>
    <% }) %>
  </select>
  <div class="hint">
    Give this role to anyone who's abusing the ticket system — while they have it, opening a ticket
    (from any panel) is blocked with a message. Remove the role to restore their access.
  </div>

  <label for="autoroleId">Role to give new members</label>
  <select id="autoroleId" name="autoroleId">
    <option value="">— None (no role is auto-assigned) —</option>
    <% options.roles.forEach(r => { %>
      <option value="<%= r.id %>" <%= settings.autorole_id === r.id ? 'selected' : '' %>><%= r.name %></option>
    <% }) %>
  </select>
  <div class="hint">
    Given automatically the moment someone joins. Make sure ModSentry's role is dragged above it
    (Server Settings → Roles) or it won't be able to assign it.
  </div>

  <div class="btn-row">
    <button class="btn" type="submit">Save</button>
  </div>
</form>

<div class="card" style="margin-top:20px;">
  <h2>Automatic role assignment</h2>
  <p class="hint" style="margin:0 0 16px;">
    When someone gains a role, automatically give them another role — and optionally take one away.
    Fires the moment the trigger role is added, whether that's by hand, another bot, or the "role to
    give new members" setting above. Rules can chain: if getting role B also triggers another rule,
    that one fires too.
  </p>

  <% if (roleTriggers.length === 0) { %>
    <p class="empty" style="margin:0 0 16px;">No rules yet.</p>
  <% } else { %>
    <ul class="list" style="margin-bottom:16px;">
      <% roleTriggers.forEach(rule => { %>
        <li class="list-item" data-delete-item>
          <div class="list-item-title">
            <span class="role-dot" style="background:<%= rule.trigger.color %>;"></span> <%= rule.trigger.name %>
            → add <span class="role-dot" style="background:<%= rule.add.color %>;"></span> <%= rule.add.name %>
            <% if (rule.remove) { %>
              , remove <span class="role-dot" style="background:<%= rule.remove.color %>;"></span> <%= rule.remove.name %>
            <% } %>
          </div>
          <div class="actions">
            <form method="post" action="/dashboard/<%= guild.id %>/settings/role-triggers/<%= rule.id %>/delete" class="js-pending-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-danger" type="submit">Delete</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/dashboard/<%= guild.id %>/settings/role-triggers">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="triggerRoleId">When someone has this role</label>
    <select id="triggerRoleId" name="triggerRoleId" required>
      <option value="">— Select a role —</option>
      <% options.roles.forEach(r => { %>
        <option value="<%= r.id %>"><%= r.name %></option>
      <% }) %>
    </select>

    <label for="addRoleId">Give them this role</label>
    <select id="addRoleId" name="addRoleId" required>
      <option value="">— Select a role —</option>
      <% options.roles.forEach(r => { %>
        <option value="<%= r.id %>"><%= r.name %></option>
      <% }) %>
    </select>

    <label for="removeRoleId">And remove this role (optional)</label>
    <select id="removeRoleId" name="removeRoleId">
      <option value="">— None —</option>
      <% options.roles.forEach(r => { %>
        <option value="<%= r.id %>"><%= r.name %></option>
      <% }) %>
    </select>

    <div class="btn-row">
      <button class="btn" type="submit">Add rule</button>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
