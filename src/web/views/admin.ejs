<%- include('partials/header', { title: 'Admin' }) %>
<h1>Closed beta</h1>
<p class="subtitle">Owner-only. Controls who can log into this dashboard at all.</p>

<%- include('partials/subnav', { sections: [
  { id: 'beta-toggle', label: 'Closed beta' },
  { id: 'allowlist', label: 'Allowed users' },
  { id: 'send-dm', label: 'Send a DM' },
  { id: 'remove-server', label: 'Remove from a server' },
] }) %>

<% if (notice) { %>
  <div class="<%= notice.ok ? 'card' : 'error' %>" style="<%= notice.ok ? 'border-color:var(--success); margin-bottom:20px;' : 'margin-bottom:20px;' %>">
    <%= notice.text %>
  </div>
<% } %>

<div class="card" id="beta-toggle">
  <form method="post" action="/admin/beta-lock">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="style-option" style="max-width:420px;">
      <input type="checkbox" name="enabled" onchange="this.form.requestSubmit()" <%= settings.betaLocked ? 'checked' : '' %>>
      <div>
        <div class="style-title">Closed beta enabled</div>
        <div class="style-desc">
          When on, only Discord accounts on the list below (plus you) can log in.
          Everyone else gets turned away at login.
        </div>
      </div>
    </label>
  </form>
</div>

<div class="card" id="allowlist">
  <h2>Allowed Discord users</h2>
  <p class="hint" style="margin-bottom:14px;">
    Find a Discord user ID via Discord → User Settings → Advanced → enable Developer Mode,
    then right-click someone → Copy User ID.
  </p>

  <% if (allowlist.length === 0) { %>
    <p class="empty">No one's been added yet — only you can log in while closed beta is on.</p>
  <% } else { %>
    <ul class="list">
      <% allowlist.forEach(a => { %>
        <li class="list-item">
          <div class="list-item-title"><%= a.discord_user_id %></div>
          <div class="actions">
            <form method="post" action="/admin/allowlist/remove" onsubmit="return confirm('Remove this user from the allowlist?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="discordUserId" value="<%= a.discord_user_id %>">
              <button class="btn btn-sm btn-danger" type="submit">Remove</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/admin/allowlist/add" style="margin-top:16px; display:flex; gap:10px; align-items:end;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1;">
      <label for="discordUserId" style="margin-top:0;">Discord user ID</label>
      <input type="text" id="discordUserId" name="discordUserId" placeholder="e.g. 1227918600753512480" pattern="\d{5,25}" required>
    </div>
    <button class="btn" type="submit">Add</button>
  </form>
</div>

<div class="card" id="send-dm">
  <h2>Send a DM as Quellum</h2>
  <p class="hint" style="margin-bottom:14px;">
    Sends an embed straight to someone's DMs from the bot. Works for anyone Quellum shares a server with
    (they need DMs from server members turned on) — you'll get an error here if it can't be delivered.
  </p>
  <form method="post" action="/admin/send-dm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="dmUserId">Discord user ID</label>
    <input type="text" id="dmUserId" name="userId" placeholder="e.g. 1227918600753512480" pattern="\d{5,25}" required>

    <label for="dmTitle">Title (optional)</label>
    <input type="text" id="dmTitle" name="title" placeholder="A message from the team">

    <label for="dmDescription">Message</label>
    <textarea id="dmDescription" name="description" required></textarea>

    <label for="dmColor">Color</label>
    <input type="color" id="dmColor" name="color" value="#5865F2">

    <div class="btn-row">
      <button class="btn" type="submit">Send DM</button>
    </div>
  </form>
</div>

<div class="card" id="remove-server">
  <h2>Remove Quellum from a server</h2>
  <p class="hint" style="margin-bottom:14px;">
    Search by server name, then leave it. There's no undo here — whoever wants Quellum back has to re-invite it.
  </p>
  <label for="serverSearch">Search servers</label>
  <input type="text" id="serverSearch" placeholder="Start typing a server name…" autocomplete="off">
  <div id="serverResults" style="margin-top:10px;"></div>
</div>

<script>
(function () {
  var guilds = <%- JSON.stringify(guilds).replace(/</g, '\\u003c') %>;
  var csrfToken = <%- JSON.stringify(csrfToken).replace(/</g, '\\u003c') %>;
  var input = document.getElementById('serverSearch');
  var results = document.getElementById('serverResults');

  function row(g) {
    var li = document.createElement('li');
    li.className = 'list-item';

    var left = document.createElement('div');
    left.style.display = 'flex';
    left.style.alignItems = 'center';
    left.style.gap = '10px';
    if (g.iconURL) {
      var img = document.createElement('img');
      img.src = g.iconURL;
      img.alt = '';
      img.style.cssText = 'width:28px;height:28px;border-radius:50%;';
      left.appendChild(img);
    }
    var text = document.createElement('div');
    var title = document.createElement('div');
    title.className = 'list-item-title';
    title.textContent = g.name;
    var meta = document.createElement('div');
    meta.className = 'list-item-meta';
    meta.textContent = g.memberCount + ' member' + (g.memberCount === 1 ? '' : 's');
    text.appendChild(title);
    text.appendChild(meta);
    left.appendChild(text);

    var form = document.createElement('form');
    form.method = 'post';
    form.action = '/admin/leave-guild';
    form.onsubmit = function () {
      return confirm('Remove Quellum from "' + g.name + '"? There\'s no undo here.');
    };
    var csrf = document.createElement('input');
    csrf.type = 'hidden'; csrf.name = '_csrf'; csrf.value = csrfToken;
    var gid = document.createElement('input');
    gid.type = 'hidden'; gid.name = 'guildId'; gid.value = g.id;
    var btn = document.createElement('button');
    btn.className = 'btn btn-sm btn-danger';
    btn.type = 'submit';
    btn.textContent = 'Leave';
    form.appendChild(csrf);
    form.appendChild(gid);
    form.appendChild(btn);

    li.appendChild(left);
    li.appendChild(form);
    return li;
  }

  function render(query) {
    results.innerHTML = '';
    var q = query.trim().toLowerCase();
    if (!q) return; // nothing shown until they actually search -- no crowded list

    var matches = guilds.filter(function (g) { return g.name.toLowerCase().indexOf(q) !== -1; }).slice(0, 8);
    if (matches.length === 0) {
      var empty = document.createElement('p');
      empty.className = 'empty';
      empty.textContent = 'No servers match "' + query + '".';
      results.appendChild(empty);
      return;
    }

    var list = document.createElement('ul');
    list.className = 'list';
    matches.forEach(function (g) { list.appendChild(row(g)); });
    results.appendChild(list);
  }

  input.addEventListener('input', function () { render(input.value); });
})();
</script>

<%- include('partials/footer') %>
