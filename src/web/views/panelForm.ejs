<%- include('partials/header', { title: panel ? 'Edit panel' : 'New panel', guild }) %>
<h1><%= panel ? 'Edit panel' : 'New panel' %></h1>
<p class="subtitle">The message users see with a button (or dropdown, if you pick more than one ticket type) to open a ticket.</p>

<% if (ticketTypes.length === 0) { %>
  <div class="card empty">Create at least one ticket type first, then come back here.</div>
<% } else { %>

<form class="card" method="post" action="<%= panel ? `/dashboard/${guild.id}/panels/${panel.id}` : `/dashboard/${guild.id}/panels` %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <label for="title">Title</label>
  <input type="text" id="title" name="title" value="<%= panel?.title || 'Support' %>" required>

  <label for="description">Description</label>
  <textarea id="description" name="description"><%= panel?.description || 'Click below to open a ticket.' %></textarea>

  <label for="color">Color</label>
  <input type="color" id="color" name="color" value="<%= panel?.color || '#5865F2' %>">

  <label>Ticket types offered by this panel</label>
  <div class="type-picker">
    <% ticketTypes.forEach(t => { %>
      <label class="type-card" style="--type-color: <%= t.welcome_color || '#5865F2' %>">
        <input type="checkbox" name="ticketTypeIds" value="<%= t.id %>" <%= panel?.ticket_type_ids?.includes(t.id) ? 'checked' : '' %>>
        <span class="type-emoji"><%= t.emoji || '🎫' %></span>
        <span class="type-name"><%= t.name %></span>
        <span class="type-meta"><%= t.support_role_ids.length %> role(s)</span>
        <span class="type-check"></span>
      </label>
    <% }) %>
  </div>
  <div class="hint">Click to toggle. Pick one for a single button, several for buttons/dropdown (your choice below).</div>

  <label>How should multiple ticket types be shown?</label>
  <div class="style-choice">
    <label class="style-option">
      <input type="radio" name="style" value="buttons" <%= (panel?.style || 'buttons') === 'buttons' ? 'checked' : '' %>>
      <div>
        <div class="style-title">Buttons</div>
        <div class="style-desc">One button per type, side by side</div>
      </div>
    </label>
    <label class="style-option">
      <input type="radio" name="style" value="select" <%= panel?.style === 'select' ? 'checked' : '' %>>
      <div>
        <div class="style-title">Dropdown menu</div>
        <div class="style-desc">A single select menu to pick from</div>
      </div>
    </label>
  </div>
  <div class="hint">Only matters if this panel offers more than one ticket type — a single type always gets a single button.</div>

  <div class="btn-row">
    <button class="btn" type="submit"><%= panel ? 'Save changes' : 'Create panel' %></button>
    <a class="btn btn-ghost" href="/dashboard/<%= guild.id %>/tickets">Cancel</a>
  </div>
</form>

<% if (panel) { %>
<div class="card">
  <h2>Post to a channel</h2>
  <p class="hint" style="margin-bottom:12px;">
    <% if (panel.channel_id) { %>
      Currently posted in #<%= (guild.channels.cache.get(panel.channel_id) || {}).name || 'unknown-channel' %>. Posting again to the same channel updates that message; a different channel posts a new one.
    <% } else { %>
      Not posted yet. Save your changes above first, then pick a channel and post it.
    <% } %>
  </p>
  <form method="post" action="/dashboard/<%= guild.id %>/panels/<%= panel.id %>/deploy">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="channelId">Channel</label>
    <select id="channelId" name="channelId" required>
      <option value="">— Select a channel —</option>
      <% options.textChannels.forEach(c => { %>
        <option value="<%= c.id %>" <%= panel.channel_id === c.id ? 'selected' : '' %>><%= c.icon %><%= c.name %></option>
      <% }) %>
    </select>
    <div class="btn-row">
      <button class="btn" type="submit"><%= panel.channel_id ? 'Update posted panel' : 'Post panel' %></button>
    </div>
  </form>
</div>
<% } %>

<% } %>
<%- include('partials/footer') %>
