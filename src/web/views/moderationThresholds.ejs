<%- include('partials/header', { title: 'Auto-punishments', guild }) %>
<a href="/dashboard/<%= guild.id %>/moderation" class="btn btn-ghost btn-sm" style="margin-bottom:16px;">&larr; Moderation</a>
<h1>Auto-punishments</h1>
<p class="subtitle">Actions that fire automatically at a warning count.</p>

<% if (notice) { %>
  <div class="<%= notice.ok ? 'card' : 'error' %>" style="<%= notice.ok ? 'border-color:var(--success); margin-bottom:20px;' : 'margin-bottom:20px;' %>">
    <%= notice.text %>
  </div>
<% } %>

<div class="card">
  <p class="hint" style="margin-bottom:14px;">
    When a member's warning count hits one of these exactly, the action fires automatically —
    on top of the warning itself, however it was given (slash command or the site).
  </p>

  <% if (settings.warning_thresholds.length === 0) { %>
    <p class="empty">No auto-punishments set up — warnings are tracked but nothing happens automatically.</p>
  <% } else { %>
    <ul class="list">
      <% settings.warning_thresholds.forEach(t => { %>
        <li class="list-item">
          <div class="list-item-title">
            At <strong><%= t.count %></strong> warning<%= t.count === 1 ? '' : 's' %> →
            <span class="badge" style="margin-left:6px; text-transform:capitalize;"><%= t.action %></span>
            <% if ((t.action === 'mute' || t.action === 'timeout') && t.duration) { %><span class="hint" style="margin-left:6px;">for <%= t.duration %></span><% } %>
          </div>
          <form method="post" action="/dashboard/<%= guild.id %>/moderation/thresholds/remove" onsubmit="return confirm('Remove this auto-punishment?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="count" value="<%= t.count %>">
            <button class="btn btn-sm btn-danger" type="submit">Remove</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/dashboard/<%= guild.id %>/moderation/thresholds/add" style="margin-top:16px; display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label for="tCount" style="margin-top:0;">Warning count</label>
      <input type="number" id="tCount" name="count" min="1" max="999" required style="width:100px;">
    </div>
    <div>
      <label for="tAction" style="margin-top:0;">Action</label>
      <select id="tAction" name="action">
        <option value="mute">Mute</option>
        <option value="kick">Kick</option>
        <option value="ban">Ban</option>
      </select>
    </div>
    <div>
      <label for="tDuration" style="margin-top:0;">Duration (mute only)</label>
      <input type="text" id="tDuration" name="duration" placeholder="e.g. 1h" style="width:120px;">
    </div>
    <button class="btn" type="submit">Add</button>
  </form>
</div>
<%- include('partials/footer') %>
