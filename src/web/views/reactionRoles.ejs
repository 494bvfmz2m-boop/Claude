<%- include('partials/header', { title: 'Reaction Roles', guild }) %>
<h1>Reaction Roles</h1>
<p class="subtitle">Post a message users react to for a role — reacting again removes it.</p>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h2>Panels</h2>
    <a class="btn btn-sm" href="/dashboard/<%= guild.id %>/reaction-roles/new">+ New panel</a>
  </div>
  <% if (panels.length === 0) { %>
    <p class="empty">No reaction role panels yet. Create one, add emoji → role mappings, then post it to a channel.</p>
  <% } else { %>
    <ul class="list">
      <% panels.forEach(p => { %>
        <li class="list-item" data-delete-item>
          <div>
            <div class="list-item-title"><%= p.title %></div>
            <div class="list-item-meta">
              <%= p.mappings.length %> mapping(s)<%= p.exclusive ? ' · exclusive' : '' %> ·
              <% if (p.channel_id) { %>posted in #<%= (guild.channels.cache.get(p.channel_id) || {}).name || 'unknown-channel' %><% } else { %>not posted yet<% } %>
            </div>
          </div>
          <div class="actions">
            <a class="btn btn-sm btn-ghost" href="/dashboard/<%= guild.id %>/reaction-roles/<%= p.id %>/edit">Edit / Post</a>
            <form method="post" action="/dashboard/<%= guild.id %>/reaction-roles/<%= p.id %>/delete" class="js-pending-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-danger" type="submit">Delete</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
  <% if (typeof disabledPanels !== 'undefined' && disabledPanels.length > 0) { %>
    <hr class="card-divider">
    <h3>Disabled by your current plan (<%= disabledPanels.length %>)</h3>
    <p class="hint" style="margin-bottom:12px;">
      Still configured, not lost. If one of these was already posted, the message stays up but stops
      granting roles while disabled — both come back automatically the moment there's room.
    </p>
    <ul class="list">
      <% disabledPanels.forEach(p => { %>
        <li class="list-item">
          <div class="list-item-title"><%= p.title %></div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
<%- include('partials/footer') %>
