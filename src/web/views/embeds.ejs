<%- include('partials/header', { title: 'Embeds', guild }) %>
<h1>Embeds</h1>
<p class="subtitle">Build a custom embed, preview it like Discord would render it, save it as a template, or send it right now.</p>

<div class="embed-builder-layout">
  <form id="embed-form" method="post" action="/dashboard/<%= guild.id %>/embeds/save">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="templateId" value="<%= loaded?.id || '' %>">

    <div class="card">
      <label for="templateName">Template name</label>
      <input type="text" id="templateName" name="templateName" value="<%= loaded?.name || '' %>" placeholder="Announcement">

      <label for="title">Title</label>
      <input type="text" id="title" name="title" value="<%= loaded?.data?.title || '' %>">

      <label for="description">Description</label>
      <textarea id="description" name="description"><%= loaded?.data?.description || '' %></textarea>

      <div class="grid">
        <div>
          <label for="color">Color</label>
          <input type="color" id="color" name="color" value="<%= loaded?.data?.color || '#5865F2' %>">
        </div>
        <div>
          <label for="url">Title link URL (optional)</label>
          <input type="url" id="url" name="url" value="<%= loaded?.data?.url || '' %>">
        </div>
      </div>

      <div class="grid">
        <div>
          <label for="authorName">Author name</label>
          <input type="text" id="authorName" name="authorName" value="<%= loaded?.data?.authorName || '' %>">
        </div>
        <div>
          <label for="authorIconUrl">Author icon URL</label>
          <input type="url" id="authorIconUrl" name="authorIconUrl" value="<%= loaded?.data?.authorIconUrl || '' %>">
        </div>
      </div>

      <div class="grid">
        <div>
          <label for="thumbnailUrl">Thumbnail image URL</label>
          <input type="url" id="thumbnailUrl" name="thumbnailUrl" value="<%= loaded?.data?.thumbnailUrl || '' %>">
        </div>
        <div>
          <label for="imageUrl">Large image URL</label>
          <input type="url" id="imageUrl" name="imageUrl" value="<%= loaded?.data?.imageUrl || '' %>">
        </div>
      </div>

      <div class="grid">
        <div>
          <label for="footerText">Footer text</label>
          <input type="text" id="footerText" name="footerText" value="<%= loaded?.data?.footerText || '' %>">
        </div>
        <div>
          <label for="footerIconUrl">Footer icon URL</label>
          <input type="url" id="footerIconUrl" name="footerIconUrl" value="<%= loaded?.data?.footerIconUrl || '' %>">
        </div>
      </div>
    </div>

    <div class="card">
      <h2>🧩 Fields</h2>
      <div id="fields-container">
        <% (loaded?.data?.fields?.length ? loaded.data.fields : []).forEach(f => { %>
          <div class="field-row">
            <div><label style="margin:0 0 4px;">Name</label><input type="text" name="fieldName[]" value="<%= f.name %>"></div>
            <div><label style="margin:0 0 4px;">Value</label><input type="text" name="fieldValue[]" value="<%= f.value %>"></div>
            <div><label style="margin:0 0 4px;">Inline</label>
              <select name="fieldInline[]"><option value="false" <%= !f.inline ? 'selected' : '' %>>No</option><option value="true" <%= f.inline ? 'selected' : '' %>>Yes</option></select>
            </div>
            <div><button type="button" class="btn btn-ghost btn-sm remove-field" style="margin-top:20px;">✕</button></div>
          </div>
        <% }) %>
      </div>
      <button type="button" id="add-field" class="btn btn-ghost btn-sm">+ Add field</button>
    </div>

    <div class="btn-row">
      <button class="btn" type="submit"><%= loaded ? 'Update template' : 'Save as template' %></button>
    </div>
  </form>

  <div class="sticky">
    <div class="card">
      <h2>👁️ Live preview</h2>
      <div id="preview" class="discord-embed-preview"></div>
    </div>

    <div class="card">
      <h2>🚀 Send now</h2>
      <form method="post" action="/dashboard/<%= guild.id %>/embeds/send" id="send-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="channelId">Channel</label>
        <select id="channelId" name="channelId" required>
          <option value="">— Select a channel —</option>
          <% options.textChannels.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.icon %><%= c.name %></option>
          <% }) %>
        </select>
        <label for="messageContent">Message text (optional, above the embed)</label>
        <input type="text" id="messageContent" name="messageContent">
        <div class="btn-row">
          <button class="btn" type="submit">Send to channel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="card">
  <h2>💾 Saved templates</h2>
  <% if (templates.length === 0) { %>
    <p class="empty">No templates saved yet.</p>
  <% } else { %>
    <ul class="list">
      <% templates.forEach(t => { %>
        <li class="list-item">
          <div class="list-item-title"><%= t.name %></div>
          <div class="actions">
            <a class="btn btn-sm btn-ghost" href="/dashboard/<%= guild.id %>/embeds?load=<%= t.id %>">Load</a>
            <form method="post" action="/dashboard/<%= guild.id %>/embeds/<%= t.id %>/delete" onsubmit="return confirm('Delete this template?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-danger" type="submit">Delete</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<script>
  // The "Send now" form shares the same fields as the "Save" form but posts to a
  // different endpoint, so it mirrors the builder's inputs in as hidden fields on submit.
  document.getElementById('send-form').addEventListener('submit', (e) => {
    const builder = document.getElementById('embed-form');
    const clone = new FormData(builder);
    for (const [key, value] of clone.entries()) {
      if (key === '_csrf' || key === 'templateId' || key === 'templateName') continue;
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = key;
      input.value = value;
      e.target.appendChild(input);
    }
  });
</script>
<script src="/js/embedPreview.js"></script>
<%- include('partials/footer') %>
