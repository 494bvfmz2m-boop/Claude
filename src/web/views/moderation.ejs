<%- include('partials/header', { title: 'Moderation', guild }) %>
<h1>🛡️ Moderation</h1>
<p class="subtitle">Swear filter, staff list, auto-punishments, and moderation actions.</p>

<%- include('partials/subnav', { sections: [
  { id: 'swear-filter', icon: '🧼', label: 'Swear filter' },
  { id: 'link-filter', icon: '🔗', label: 'Link filter' },
  { id: 'hierarchy', icon: '👮', label: 'Staff list' },
  { id: 'thresholds', icon: '🚨', label: 'Auto-punishments' },
  { id: 'actions', icon: '⚡', label: 'Issue a punishment' },
  { id: 'mod-log', icon: '🗒️', label: 'Log' },
] }) %>

<% if (notice) { %>
  <div class="<%= notice.ok ? 'card' : 'error' %>" style="<%= notice.ok ? 'border-color:var(--success); margin-bottom:20px;' : 'margin-bottom:20px;' %>">
    <%= notice.text %>
  </div>
<% } %>

<div class="card" id="swear-filter">
  <h2>🧼 Swear filter</h2>
  <form method="post" action="/dashboard/<%= guild.id %>/moderation/swear-filter">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label class="style-option" style="max-width:280px;">
      <input type="checkbox" name="enabled" <%= settings.swear_filter_enabled ? 'checked' : '' %>>
      <div>
        <div class="style-title">Enabled</div>
        <div class="style-desc">Delete messages containing any word below</div>
      </div>
    </label>

    <label for="words">Banned words</label>
    <div style="display:flex; gap:10px; align-items:center; margin-bottom:10px;">
      <select id="swearFilterPreset" style="flex:1;">
        <option value="">— Load a starter list (optional) —</option>
        <option value="mild">🟡 Mild profanity</option>
        <option value="strict">🔴 Strict (extended list)</option>
      </select>
      <button type="button" id="loadSwearPreset" class="btn btn-ghost btn-sm">Load</button>
    </div>
    <textarea id="words" name="words" placeholder="one per line, or comma-separated" style="min-height:120px;"><%= settings.swear_words.join('\n') %></textarea>
    <div class="hint">
      Case-insensitive, whole-word matching (won't flag a word just for containing one of these as a substring).
      Staff with the Manage Messages permission are never filtered. Starter lists are just a starting point —
      edit freely, and add/remove words to fit your server. They don't include slurs; add anything
      community-specific yourself.
    </div>

    <div class="btn-row">
      <button class="btn" type="submit">Save</button>
    </div>
  </form>
</div>

<div class="card" id="link-filter">
  <h2>🔗 Link filter</h2>
  <form method="post" action="/dashboard/<%= guild.id %>/moderation/link-filter">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>Quick presets</label>
    <div class="btn-row" style="margin-bottom:14px;">
      <button type="button" class="btn btn-ghost btn-sm link-filter-preset" data-mode="invites">🚫 No advertising</button>
      <button type="button" class="btn btn-ghost btn-sm link-filter-preset" data-mode="all">🔒 Lockdown</button>
      <button type="button" class="btn btn-ghost btn-sm link-filter-preset" data-mode="off">✅ Open</button>
    </div>

    <label for="linkFilterMode">Mode</label>
    <select id="linkFilterMode" name="mode">
      <option value="off" <%= settings.link_filter_mode === 'off' ? 'selected' : '' %>>Off</option>
      <option value="invites" <%= settings.link_filter_mode === 'invites' ? 'selected' : '' %>>Block Discord invite links only</option>
      <option value="all" <%= settings.link_filter_mode === 'all' ? 'selected' : '' %>>Block all links</option>
    </select>
    <div class="hint">
      "Invite links only" catches discord.gg and discord.com/invite links — handy for blocking server
      advertising without stopping people sharing normal links. Staff with Manage Messages are never
      filtered, and deletions get logged the same way the swear filter's do.
    </div>

    <div class="btn-row">
      <button class="btn" type="submit">Save</button>
    </div>
  </form>
</div>

<div class="card" id="hierarchy">
  <h2>👮 Staff List</h2>
  <p class="hint" style="margin-bottom:14px;">
    Ranks power <code>/promote</code> and <code>/demote</code>, and drive the auto-updating list posted
    to Discord below. Highest rank at the top. You can only promote/demote someone to a rank strictly
    below your own (server owners and Administrators bypass this).
  </p>

  <% if (hierarchy.length === 0) { %>
    <p class="empty">No hierarchy set up yet — add a role below to get started.</p>
  <% } else { %>
    <form method="post" action="/dashboard/<%= guild.id %>/moderation/hierarchy/reorder">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <ul class="list">
        <% hierarchy.forEach((h) => { %>
          <li class="list-item">
            <div class="list-item-title">
              <span class="role-dot" style="background:<%= h.color %>; width:10px; height:10px; border-radius:50%; display:inline-block; margin-right:8px;"></span>
              <%= h.name %>
            </div>
            <div class="actions">
              <label style="display:flex; align-items:center; gap:6px; font-size:13px; color:var(--text-muted);">
                Rank
                <input type="number" name="rank_<%= h.roleId %>" value="<%= h.rank %>" min="1" style="width:70px;">
              </label>
              <button class="btn btn-sm btn-danger" type="submit" formnovalidate formaction="/dashboard/<%= guild.id %>/moderation/hierarchy/remove" name="roleId" value="<%= h.roleId %>" onclick="return confirm('Remove this rank from the hierarchy?');">Remove</button>
            </div>
          </li>
        <% }) %>
      </ul>
      <div class="hint" style="margin-bottom:10px;">Higher number = higher rank. Edit any rank and hit Save — order updates however you've numbered them.</div>
      <div class="btn-row">
        <button class="btn" type="submit">Save order</button>
      </div>
    </form>
  <% } %>

  <% if (availableRoles.length > 0) { %>
    <form method="post" action="/dashboard/<%= guild.id %>/moderation/hierarchy/add" style="margin-top:16px; display:flex; gap:10px; align-items:end;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div style="flex:1;">
        <label for="roleId" style="margin-top:0;">Add a rank (becomes the new highest)</label>
        <select id="roleId" name="roleId">
          <% availableRoles.forEach(r => { %>
            <option value="<%= r.id %>"><%= r.name %></option>
          <% }) %>
        </select>
      </div>
      <button class="btn" type="submit">Add</button>
    </form>
  <% } %>

  <hr class="card-divider">

  <div class="subhead">Auto-updating list message</div>
  <form method="post" action="/dashboard/<%= guild.id %>/moderation/staff-list-channel" style="display:flex; gap:16px; align-items:end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1; min-width:220px;">
      <label for="channelId" style="margin-top:0;">Channel</label>
      <select id="channelId" name="channelId">
        <option value="">— None (no auto-updating list) —</option>
        <% options.textChannels.forEach(c => { %>
          <option value="<%= c.id %>" <%= settings.staff_list_channel_id === c.id ? 'selected' : '' %>><%= c.icon %><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="staffColor" style="margin-top:0;">Embed color</label>
      <input type="color" id="staffColor" name="color" value="<%= settings.staff_list_color %>">
    </div>
    <button class="btn" type="submit">Save</button>
  </form>
  <div class="hint" style="margin-top:10px;">
    Posts (and keeps updated) one message here listing everyone in each hierarchy rank, one role per row,
    with everyone in it actually @mentioned. Updates automatically a few seconds after anyone's staff role
    changes — or hit the button below to post/refresh it right now.
  </div>

  <form method="post" action="/dashboard/<%= guild.id %>/moderation/staff-list/post" style="margin-top:14px;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-ghost" type="submit">📮 Post / refresh now</button>
  </form>
</div>

<div class="card" id="thresholds">
  <h2>🚨 Auto-punishments</h2>
  <p class="hint" style="margin-bottom:14px;">
    When a member's warning count hits one of these exactly, the action fires automatically —
    on top of the warning itself, however it was given (slash command or the site).
  </p>

  <% if (settings.warning_thresholds.length === 0) { %>
    <p class="empty">No auto-punishments set up — warnings are tracked but nothing happens automatically.</p>
  <% } else { %>
    <ul class="list">
      <% settings.warning_thresholds.forEach(t => { %>
        <li class="list-item">
          <div class="list-item-title">
            At <strong><%= t.count %></strong> warning<%= t.count === 1 ? '' : 's' %> →
            <span class="badge" style="margin-left:6px; text-transform:capitalize;"><%= t.action %></span>
            <% if ((t.action === 'mute' || t.action === 'timeout') && t.duration) { %><span class="hint" style="margin-left:6px;">for <%= t.duration %></span><% } %>
          </div>
          <form method="post" action="/dashboard/<%= guild.id %>/moderation/thresholds/remove" onsubmit="return confirm('Remove this auto-punishment?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="count" value="<%= t.count %>">
            <button class="btn btn-sm btn-danger" type="submit">Remove</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/dashboard/<%= guild.id %>/moderation/thresholds/add" style="margin-top:16px; display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label for="tCount" style="margin-top:0;">Warning count</label>
      <input type="number" id="tCount" name="count" min="1" max="999" required style="width:100px;">
    </div>
    <div>
      <label for="tAction" style="margin-top:0;">Action</label>
      <select id="tAction" name="action">
        <option value="mute">Mute</option>
        <option value="kick">Kick</option>
        <option value="ban">Ban</option>
      </select>
    </div>
    <div>
      <label for="tDuration" style="margin-top:0;">Duration (mute only)</label>
      <input type="text" id="tDuration" name="duration" placeholder="e.g. 1h" style="width:120px;">
    </div>
    <button class="btn" type="submit">Add</button>
  </form>
</div>

<div class="card" id="actions">
  <h2>⚡ Issue a punishment</h2>
  <p class="hint" style="margin-bottom:14px;">
    Runs the same as the matching slash command — bans/kicks/mutes/warns actually happen in Discord,
    and get logged below either way. Which of these you can use is controlled from the
    <a href="/dashboard/<%= guild.id %>/permissions">Permissions</a> page, not your Discord permissions directly.
  </p>
  <form method="post" action="/dashboard/<%= guild.id %>/moderation/actions" style="display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label for="actionType" style="margin-top:0;">Action</label>
      <select id="actionType" name="action" onchange="document.getElementById('durationField').style.display = this.value === 'mute' ? '' : 'none';">
        <option value="warn">Warn</option>
        <option value="mute">Mute</option>
        <option value="unmute">Unmute</option>
        <option value="kick">Kick</option>
        <option value="ban">Ban</option>
        <option value="unban">Unban</option>
      </select>
    </div>
    <div>
      <label for="targetId" style="margin-top:0;">Discord user ID or username</label>
      <input type="text" id="targetId" name="targetId" placeholder="username, or their ID" required style="width:200px;">
    </div>
    <div id="durationField" style="display:none;">
      <label for="actionDuration" style="margin-top:0;">Duration</label>
      <input type="text" id="actionDuration" name="duration" placeholder="e.g. 1h" style="width:100px;">
    </div>
    <div style="flex:1; min-width:200px;">
      <label for="actionReason" style="margin-top:0;">Reason</label>
      <input type="text" id="actionReason" name="reason" placeholder="Required for warnings">
    </div>
    <button class="btn" type="submit">Do it</button>
  </form>
  <div class="hint" style="margin-top:10px;">Unban needs their exact Discord user ID — banned users can't be found by username.</div>
</div>

<div class="card" id="mod-log">
  <h2>🗒️ Moderation log</h2>
  <% if (actions.length === 0) { %>
    <p class="empty">Nothing logged yet.</p>
  <% } else { %>
    <ul class="list">
      <% actions.forEach(a => { %>
        <li class="list-item">
          <div>
            <div class="list-item-title"><%= a.action %></div>
            <div class="list-item-meta">
              <%= a.target_tag || a.target_id || 'Unknown' %> · by <%= a.moderator_tag || a.moderator_id %> ·
              <%= new Date(a.created_at + 'Z').toLocaleString() %>
              <%= a.source === 'dashboard' ? '· 🌐 Site' : '' %>
              <% if (a.reason) { %><br><%= a.reason %><% } %>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<script>
(function () {
  var SWEAR_PRESETS = {
    mild: ['damn', 'hell', 'crap', 'ass', 'piss', 'bastard'],
    strict: ['damn', 'hell', 'crap', 'ass', 'piss', 'bastard', 'bitch', 'dick', 'fuck', 'shit', 'cock', 'cunt', 'asshole', 'motherfucker'],
  };

  var presetSelect = document.getElementById('swearFilterPreset');
  var loadBtn = document.getElementById('loadSwearPreset');
  var wordsField = document.getElementById('words');
  if (loadBtn && presetSelect && wordsField) {
    loadBtn.addEventListener('click', function () {
      var key = presetSelect.value;
      if (!key || !SWEAR_PRESETS[key]) return;
      if (wordsField.value.trim() && !confirm('Replace the current word list with this starter list?')) return;
      wordsField.value = SWEAR_PRESETS[key].join('\n');
    });
  }

  var linkFilterSelect = document.getElementById('linkFilterMode');
  document.querySelectorAll('.link-filter-preset').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (linkFilterSelect) linkFilterSelect.value = btn.dataset.mode;
    });
  });
})();
</script>
<%- include('partials/footer') %>
