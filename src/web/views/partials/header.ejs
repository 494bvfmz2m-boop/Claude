<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ModSentry' : 'ModSentry' %></title>
  <link rel="icon" type="image/svg+xml" href="/img/modsentry-favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div id="modsentry-splash" class="modsentry-splash" aria-hidden="true">
  <img src="/img/modsentry-logo-impact.svg" alt="" width="120" height="120">
</div>
<script>
(function () {
  var el = document.getElementById('modsentry-splash');
  if (!el) return;
  // Plays on every full page load (every dashboard nav click is one) --
  // deliberately not gated to "once per session" anymore, since that made
  // it disappear after the very first page and look broken.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { el.remove(); return; }
  window.addEventListener('load', function () {
    setTimeout(function () {
      el.classList.add('modsentry-splash--out');
      setTimeout(function () { el.remove(); }, 300);
    }, 500);
  });
})();
</script>
<header class="topbar">
  <a class="brand" href="/">
    <span class="brand-spin3d" aria-hidden="true">
      <span class="brand-spin3d__rig">
        <span class="brand-spin3d__face brand-spin3d__face--front">
          <svg viewBox="0 0 200 200" width="100%" height="100%" fill="none">
            <path d="M100 12 L172 40 V104 C172 148 138 174 100 190 C62 174 28 148 28 104 V40 Z" fill="#eef6ff" stroke="#1d1f20" stroke-width="9"/>
            <path d="M64 66 L100 40 L136 66" stroke="#f0455f" stroke-width="14" stroke-linecap="square"/>
            <path d="M64 100 L100 74 L136 100" stroke="#c8102e" stroke-width="14" stroke-linecap="square"/>
            <path d="M64 134 L100 108 L136 134" stroke="#7d0a1d" stroke-width="14" stroke-linecap="square"/>
          </svg>
        </span>
        <span class="brand-spin3d__face brand-spin3d__face--back">
          <svg viewBox="0 0 200 200" width="100%" height="100%" fill="none">
            <path d="M100 12 L172 40 V104 C172 148 138 174 100 190 C62 174 28 148 28 104 V40 Z" fill="#c8102e" stroke="#1d1f20" stroke-width="9"/>
            <path d="M64 66 L100 40 L136 66" stroke="#eef6ff" stroke-width="14" stroke-linecap="square"/>
            <path d="M64 100 L100 74 L136 100" stroke="#eef6ff" stroke-width="14" stroke-linecap="square"/>
            <path d="M64 134 L100 108 L136 134" stroke="#eef6ff" stroke-width="14" stroke-linecap="square"/>
          </svg>
        </span>
      </span>
    </span>
    <span class="brand-word">ModSentry</span>
  </a>
  <% if (typeof guild !== 'undefined' && guild) {
    var access = typeof dashboardAccess !== 'undefined' ? dashboardAccess : null;
    var canSee = function (area) { return !access || access.level === 'full' || (access.areas && access.areas.has(area)); };
    var isFullAccess = !access || access.level === 'full';
  %>
    <nav class="topnav">
      <span class="guild-chip" id="tourGuildChip">
        <img class="guild-icon" src="<%= guild.iconURL({ size: 64 }) || 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22/%3E' %>" alt="">
        <span class="guild-name"><%= guild.name %></span>
      </span>
      <a href="/">Servers</a>
      <% if (canSee('tickets')) { %><a href="/dashboard/<%= guild.id %>/tickets" id="tourNavTickets">Tickets</a><% } %>
      <% if (canSee('embeds')) { %><a href="/dashboard/<%= guild.id %>/embeds">Embeds</a><% } %>
      <% if (canSee('reaction_roles')) { %><a href="/dashboard/<%= guild.id %>/reaction-roles">Reaction Roles</a><% } %>
      <% if (canSee('moderation')) { %><a href="/dashboard/<%= guild.id %>/moderation" id="tourNavModeration">Moderation</a><% } %>
      <% if (canSee('settings')) { %><a href="/dashboard/<%= guild.id %>/settings" id="tourNavSettings">Settings</a><% } %>
      <% if (isFullAccess) { %><a href="/dashboard/<%= guild.id %>/permissions" id="tourNavPermissions">Permissions</a><% } %>
    </nav>
  <% } %>
  <span class="bot-status <%= botStatus.ready ? 'online' : 'offline' %>" title="<%= botStatus.ready ? `Connected to ${botStatus.guildCount} server(s)` : 'Not connected to Discord' %>">
    <span class="dot"></span>
    <%= botStatus.ready ? 'Bot online' : 'Bot offline' %><%= botStatus.ping !== null ? ` · ${botStatus.ping}ms` : '' %>
  </span>
  <a class="btn btn-ghost" style="margin-left:auto;" href="https://discord.gg/5bNyCzsyJ2" target="_blank" rel="noopener">Discord</a>
  <% if ((typeof hideLogout === 'undefined' || !hideLogout) && discordUser) { %>
    <% if (isOwner) { %>
      <a class="btn btn-ghost" href="/admin" id="tourAdminBtn">Admin</a>
    <% } %>
    <a class="btn btn-ghost" href="<%= inviteUrl %>" target="_blank" rel="noopener" id="tourInviteBtn">+ Invite to Server</a>
    <span class="user-chip" style="border-right:none;">
      <img class="user-avatar" src="<%= discordUser.avatar ? `https://cdn.discordapp.com/avatars/${discordUser.id}/${discordUser.avatar}.png?size=64` : `https://cdn.discordapp.com/embed/avatars/${(BigInt(discordUser.id) >> 22n) % 6n}.png` %>" alt="">
      <%= discordUser.username %>
    </span>
    <form action="/logout" method="post" class="logout-form" style="margin-left:0;">
      <button class="btn btn-ghost" type="submit">Log out</button>
    </form>
  <% } %>
</header>
<% if (typeof guild !== 'undefined' && guild) { %>
  <div class="role-warning">
    <strong>Note:</strong> Drag ModSentry's role above every role you want it to manage — Server Settings → Roles in Discord — or ticket
    access, staff ranks, timeouts, and reaction roles won't work for those roles.
  </div>
  <script src="/js/tour.js"></script>
  <script>
  (function () {
    var SEEN_GUILD_NAV = 'modsentryTourGuildNavSeen';
    var seen = false;
    try { seen = !!localStorage.getItem(SEEN_GUILD_NAV); } catch (e) {}
    if (seen) return;

    var STEPS = [
      { selector: '#tourGuildChip', title: "This server's dashboard", body: 'Everything here only affects this server. Use "Servers" on the left to switch to another one you manage.' },
      { selector: '#tourNavTickets', title: 'Tickets', body: 'Set up ticket types and panels, and see what\'s open.' },
      { selector: '#tourNavModeration', title: 'Moderation', body: 'Swear/link filters, staff hierarchy, auto-punishments, and a log of every action.' },
      { selector: '#tourNavSettings', title: 'Settings', body: 'Channels, roles, and welcome/leave messages for this server.' },
      { selector: '#tourNavPermissions', title: 'Permissions', body: 'Control exactly what each role can do here, without touching real Discord permissions.' },
    ];

    setTimeout(function () {
      new ModSentryTour(STEPS, {
        onEnd: function () {
          try { localStorage.setItem(SEEN_GUILD_NAV, '1'); } catch (e) {}
        },
      }).start();
    }, 900);
  })();
  </script>
<% } %>
<main class="container">
