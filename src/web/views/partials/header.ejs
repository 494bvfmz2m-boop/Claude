<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · Quellum' : 'Quellum' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Quellum</a>
  <% if (typeof guild !== 'undefined' && guild) { %>
    <nav class="topnav">
      <span class="guild-name"><%= guild.name %></span>
      <a href="/dashboard/<%= guild.id %>/tickets">Tickets</a>
      <a href="/dashboard/<%= guild.id %>/embeds">Embeds</a>
      <a href="/dashboard/<%= guild.id %>/moderation">Moderation</a>
      <a href="/dashboard/<%= guild.id %>/settings">Settings</a>
    </nav>
  <% } %>
  <span class="bot-status <%= botStatus.ready ? 'online' : 'offline' %>" title="<%= botStatus.ready ? `Connected to ${botStatus.guildCount} server(s)` : 'Not connected to Discord' %>">
    <span class="dot"></span>
    <%= botStatus.ready ? 'Bot online' : 'Bot offline' %><%= botStatus.ping !== null ? ` · ${botStatus.ping}ms` : '' %>
  </span>
  <% if ((typeof hideLogout === 'undefined' || !hideLogout) && discordUser) { %>
    <a class="btn btn-ghost" style="margin-left:auto;" href="<%= inviteUrl %>" target="_blank" rel="noopener">+ Invite to Server</a>
    <span class="guild-name" style="border-right:none;"><%= discordUser.username %></span>
    <form action="/logout" method="post" class="logout-form" style="margin-left:0;">
      <button class="btn btn-ghost" type="submit">Log out</button>
    </form>
  <% } %>
</header>
<main class="container">
