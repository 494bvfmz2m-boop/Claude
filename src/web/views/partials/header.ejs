<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · Ticket Bot' : 'Ticket Bot' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">🎫 Ticket Bot</a>
  <% if (typeof guild !== 'undefined' && guild) { %>
    <nav class="topnav">
      <span class="guild-name"><%= guild.name %></span>
      <a href="/dashboard/<%= guild.id %>/tickets">Tickets</a>
      <a href="/dashboard/<%= guild.id %>/embeds">Embeds</a>
      <a href="/dashboard/<%= guild.id %>/settings">Settings</a>
    </nav>
  <% } %>
  <% if (typeof hideLogout === 'undefined' || !hideLogout) { %>
    <form action="/logout" method="post" class="logout-form">
      <button class="btn btn-ghost" type="submit">Log out</button>
    </form>
  <% } %>
</header>
<main class="container">
