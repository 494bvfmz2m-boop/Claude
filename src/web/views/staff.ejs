<%- include('partials/header', { title: 'Staff' }) %>
<h1>Staff</h1>
<p class="subtitle">Owner and admin controls — who can log in, who else can manage this, and bot-wide tools.</p>

<%
  // Only list anchors for sections this session can actually see -- same
  // gating as the cards themselves (canSee/isOwner), so a scoped staff
  // role's nav doesn't advertise tools it can't reach.
  const allStaffSections = [
    { id: 'overview', label: 'Overview' },
    { id: 'health', label: 'Server health' },
    { id: 'staff-notes', label: 'Pinned notes' },
    { id: 'beta-toggle', label: 'Closed beta', area: 'beta' },
    { id: 'admins', label: 'Admins', ownerOnly: true },
    { id: 'staff-roles', label: 'Staff roles', ownerOnly: true },
    { id: 'subscriptions', label: 'Subscriptions', ownerOnly: true },
    { id: 'allowlist', label: 'Allowed users', area: 'beta' },
    { id: 'blocklist', label: 'Blocklist', area: 'blocklist' },
    { id: 'test-beta-dm', label: 'Test beta DMs', area: 'beta' },
    { id: 'contacts', label: 'Contacts', area: 'contacts' },
    { id: 'emoji-book', label: 'Emoji book', area: 'emoji_book' },
    { id: 'server-notes', label: 'Server notes', area: 'server_notes' },
    { id: 'dm-form', label: 'Application form', area: 'dm_form' },
    { id: 'send-dm', label: 'Send a DM', area: 'send_dm' },
    { id: 'broadcast', label: 'Broadcast to owners', area: 'broadcast' },
    { id: 'maintenance', label: 'Maintenance banner', area: 'maintenance' },
    { id: 'user-lookup', label: 'User lookup' },
    { id: 'audit-log', label: 'Audit log' },
    { id: 'backup', label: 'Backup', ownerOnly: true },
    { id: 'remove-server', label: 'Remove from a server', area: 'remove_server' },
  ];
  const visibleStaffSections = allStaffSections.filter((s) => (!s.ownerOnly || isOwner) && (!s.area || canSee(s.area)));
%>
<%- include('partials/subnav', { sections: visibleStaffSections }) %>

<% if (notice) { %>
  <div class="<%= notice.ok ? 'card' : 'error' %>" style="<%= notice.ok ? 'border-color:var(--success); margin-bottom:20px;' : 'margin-bottom:20px;' %>">
    <%= notice.text %>
  </div>
<% } %>

<h2 class="staff-group-heading">Overview</h2>

<div id="overview">
  <div class="stat-grid">
    <div class="stat-tile"><div class="stat-tile-value"><%= overview.servers %></div><div class="stat-tile-label">Servers</div></div>
    <div class="stat-tile"><div class="stat-tile-value"><%= overview.members.toLocaleString() %></div><div class="stat-tile-label">Members reached</div></div>
    <div class="stat-tile"><div class="stat-tile-value"><%= overview.ticketsOpen %> / <%= overview.ticketsTotal %></div><div class="stat-tile-label">Tickets open / ever</div></div>
    <div class="stat-tile"><div class="stat-tile-value"><%= overview.modActionsTotal %></div><div class="stat-tile-label">Mod actions logged</div></div>
    <div class="stat-tile"><div class="stat-tile-value"><%= overview.warningsTotal %></div><div class="stat-tile-label">Warnings issued</div></div>
    <div class="stat-tile"><div class="stat-tile-value"><%= overview.giveawaysActive %></div><div class="stat-tile-label">Active giveaways</div></div>
    <div class="stat-tile"><div class="stat-tile-value"><%= overview.pollsActive %></div><div class="stat-tile-label">Open polls</div></div>
    <div class="stat-tile"><div class="stat-tile-value"><%= overview.admins %></div><div class="stat-tile-label">Admins (incl. you)</div></div>
    <div class="stat-tile"><div class="stat-tile-value"><%= overview.uptime %></div><div class="stat-tile-label">Uptime</div></div>
  </div>
</div>

<div class="card" id="health">
  <h2>Server health</h2>
  <p class="hint" style="margin-bottom:14px;">
    Servers missing something worth setting up — purely informational, nothing here is broken.
  </p>
  <% if (healthChecks.length === 0) { %>
    <p class="empty">Every server has the basics covered.</p>
  <% } else { %>
    <ul class="list">
      <% healthChecks.forEach(g => { %>
        <li class="list-item">
          <div style="display:flex; align-items:center; gap:12px; min-width:0;">
            <% if (g.iconURL) { %><img src="<%= g.iconURL %>" alt="" class="contact-avatar"><% } %>
            <div style="min-width:0;">
              <div class="list-item-title"><%= g.name %></div>
              <div class="list-item-meta"><%= g.issues.join(' · ') %></div>
            </div>
          </div>
          <div class="actions">
            <a class="btn btn-sm btn-ghost" href="/dashboard/<%= g.id %>/settings">Open</a>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<h2 class="staff-group-heading">Pinned notes</h2>

<div class="card" id="staff-notes">
  <h2>Staff notes</h2>
  <p class="hint" style="margin-bottom:14px;">
    A shared scratchpad for admins — leave a note for the others to see next time they log in.
  </p>
  <% if (staffNotes.length === 0) { %>
    <p class="empty">No notes pinned right now.</p>
  <% } else { %>
    <ul class="list">
      <% staffNotes.forEach(n => { %>
        <li class="list-item" data-delete-item>
          <div>
            <div class="list-item-title"><%= n.note %></div>
            <div class="list-item-meta"><%= n.author_tag || n.author_id %> · <%= n.created_at %></div>
          </div>
          <div class="actions">
            <form method="post" action="/staff/staff-notes/remove" class="js-pending-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="id" value="<%= n.id %>">
              <button class="btn btn-sm btn-danger" type="submit">Remove</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/staff/staff-notes/add" style="margin-top:16px; display:flex; gap:10px; align-items:end;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1;">
      <label style="margin-top:0;">New note</label>
      <input type="text" name="note" maxlength="500" placeholder="e.g. Don't touch the swear filter today, I'm mid-edit" required>
    </div>
    <button class="btn" type="submit">Pin note</button>
  </form>
</div>

<% if (isOwner || canSee('beta') || canSee('blocklist')) { %>
<h2 class="staff-group-heading">Access &amp; beta</h2>
<% } %>

<% if (canSee('beta')) { %>
<div class="card" id="beta-toggle">
  <form method="post" action="/staff/beta-lock">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="style-option" style="max-width:420px;">
      <input type="checkbox" name="enabled" onchange="this.form.requestSubmit()" <%= settings.betaLocked ? 'checked' : '' %>>
      <div>
        <div class="style-title">Closed beta enabled</div>
        <div class="style-desc">
          When on, only Discord accounts on the list below (plus you) can log in.
          Everyone else gets turned away at login and can request access there.
        </div>
      </div>
    </label>
  </form>
</div>
<% } %>

<% if (isOwner) { %>
<div class="card" id="admins">
  <h2>Admins</h2>
  <p class="hint" style="margin-bottom:14px;">
    Owner-only. Everyone below gets full <code>/staff</code> access, same as you — except managing this
    list and downloading a database backup, which stay owner-only. They can still log into the dashboard
    while closed beta is on.
  </p>

  <% if (admins.length === 0) { %>
    <p class="empty">No other admins yet — add one below.</p>
  <% } else { %>
    <ul class="list">
      <% admins.forEach(a => { %>
        <li class="list-item" data-delete-item>
          <div style="display:flex; align-items:center; gap:12px; min-width:0;">
            <% if (a.resolved) { %>
              <img src="<%= a.avatarURL %>" alt="" class="contact-avatar">
            <% } else { %>
              <span class="contact-avatar" style="display:flex; align-items:center; justify-content:center; font-size:11px; color:var(--text-muted);">?</span>
            <% } %>
            <div style="min-width:0;">
              <div class="list-item-title"><%= a.resolved ? a.tag : 'Unknown user' %></div>
              <div class="list-item-meta">
                <span class="contact-id" style="display:inline;"><%= a.id %></span><% if (a.note) { %> · <%= a.note %><% } %>
              </div>
            </div>
          </div>
          <div class="actions">
            <form method="post" action="/staff/admins/remove" class="js-pending-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="discordUserId" value="<%= a.id %>">
              <button class="btn btn-sm btn-danger" type="submit">Remove</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/staff/admins/add" style="margin-top:16px; display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1; min-width:200px;">
      <label for="adminUserId" style="margin-top:0;">Discord user ID</label>
      <input type="text" id="adminUserId" name="discordUserId" placeholder="e.g. 1227918600753512480" pattern="\d{5,25}" required>
    </div>
    <div style="flex:1; min-width:200px;">
      <label for="adminNote" style="margin-top:0;">Note (optional)</label>
      <input type="text" id="adminNote" name="note" placeholder="e.g. co-owner" maxlength="200">
    </div>
    <button class="btn" type="submit">Add admin</button>
  </form>
</div>

<div class="card" id="staff-roles">
  <h2>Custom staff roles</h2>
  <p class="hint" style="margin-bottom:14px;">
    Grant scoped <code>/staff</code> access without making someone a full admin — create a role, check the
    areas it should cover, then add whoever needs it by Discord user ID. Someone can belong to more than one
    role; their access is the combination of all of them. They can log in while closed beta is on, same as
    a full admin.
  </p>

  <% if (staffRoles.length === 0) { %>
    <p class="empty">No custom roles yet — create one below.</p>
  <% } else { %>
    <% staffRoles.forEach(role => { %>
      <details class="role-panel" data-delete-item>
        <summary class="role-summary">
          <span class="role-summary-left">
            <svg class="role-chevron" width="10" height="10" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="role-summary-name"><%= role.name %></span>
            <span class="role-summary-meta"><%= role.members.length %> member<%= role.members.length === 1 ? '' : 's' %></span>
          </span>
          <span class="role-summary-right">
            <% if (role.areas.length === 0) { %>
              <span class="badge">No access granted</span>
            <% } else { %>
              <span class="badge badge-open"><%= role.areas.length %> area<%= role.areas.length === 1 ? '' : 's' %></span>
            <% } %>
          </span>
        </summary>

        <div class="role-panel-body">
          <form method="post" action="/staff/staff-roles/<%= role.id %>/save">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label style="margin-top:0;">Name</label>
            <input type="text" name="name" value="<%= role.name %>" maxlength="100" required>

            <label style="margin-top:14px;">Areas granted</label>
            <div class="perm-grid">
              <% staffAreaDefs.forEach(a => { %>
                <label class="perm-item" title="<%= a.description %>">
                  <input type="checkbox" name="areas" value="<%= a.key %>" <%= role.areas.includes(a.key) ? 'checked' : '' %>>
                  <span><%= a.label %></span>
                </label>
              <% }) %>
            </div>

            <div class="btn-row">
              <button class="btn btn-sm" type="submit">Save</button>
              <button class="btn btn-sm btn-danger js-pending-delete-btn" type="submit" formaction="/staff/staff-roles/<%= role.id %>/delete">Delete role</button>
            </div>
          </form>

          <h3 style="margin-top:18px;">Members</h3>
          <% if (role.members.length === 0) { %>
            <p class="empty">No one has this role yet.</p>
          <% } else { %>
            <ul class="list">
              <% role.members.forEach(m => { %>
                <li class="list-item" data-delete-item>
                  <div style="display:flex; align-items:center; gap:12px; min-width:0;">
                    <% if (m.resolved) { %>
                      <img src="<%= m.avatarURL %>" alt="" class="contact-avatar">
                    <% } else { %>
                      <span class="contact-avatar" style="display:flex; align-items:center; justify-content:center; font-size:11px; color:var(--text-muted);">?</span>
                    <% } %>
                    <div style="min-width:0;">
                      <div class="list-item-title"><%= m.resolved ? m.tag : 'Unknown user' %></div>
                      <div class="list-item-meta">
                        <span class="contact-id" style="display:inline;"><%= m.id %></span><% if (m.note) { %> · <%= m.note %><% } %>
                      </div>
                    </div>
                  </div>
                  <div class="actions">
                    <form method="post" action="/staff/staff-roles/<%= role.id %>/members/remove" class="js-pending-delete">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="discordUserId" value="<%= m.id %>">
                      <button class="btn btn-sm btn-danger" type="submit">Remove</button>
                    </form>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } %>

          <form method="post" action="/staff/staff-roles/<%= role.id %>/members/add" style="margin-top:14px; display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div style="flex:1; min-width:200px;">
              <label style="margin-top:0;">Discord user ID</label>
              <input type="text" name="discordUserId" placeholder="e.g. 1227918600753512480" pattern="\d{5,25}" required>
            </div>
            <div style="flex:1; min-width:200px;">
              <label style="margin-top:0;">Note (optional)</label>
              <input type="text" name="note" placeholder="e.g. support team" maxlength="200">
            </div>
            <button class="btn btn-sm" type="submit">Add member</button>
          </form>
        </div>
      </details>
    <% }) %>
  <% } %>

  <h3 style="margin-top:20px;">Create a role</h3>
  <form method="post" action="/staff/staff-roles/create">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label style="margin-top:0;">Name</label>
    <input type="text" name="name" placeholder="e.g. Support Specialist" maxlength="100" required>

    <label style="margin-top:14px;">Areas granted</label>
    <div class="perm-grid">
      <% staffAreaDefs.forEach(a => { %>
        <label class="perm-item" title="<%= a.description %>">
          <input type="checkbox" name="areas" value="<%= a.key %>">
          <span><%= a.label %></span>
        </label>
      <% }) %>
    </div>

    <div class="btn-row">
      <button class="btn" type="submit">Create role</button>
    </div>
  </form>
</div>

<div class="card" id="subscriptions">
  <h2>Subscriptions (Tebex)</h2>
  <p class="hint" style="margin-bottom:14px;">
    Grants premium dashboard features to whoever holds a matching Tebex subscription -- global, not
    per-server, since Tebex sells to a Discord <em>person</em>. Nothing in the dashboard is gated behind a
    tier's features yet; wire <code>requirePremiumFeature('key')</code> (see
    <code>web/lib/subscriptionGate.js</code>) into a route once you've decided what's premium.
  </p>

  <h3 style="margin-top:0;">Webhook</h3>
  <p class="hint" style="margin-bottom:10px;">
    In your Tebex creator panel, add a webhook pointing at the URL below, then paste its
    <strong>Webhook Signature Secret</strong> here. Tebex sends a <code>validation.webhook</code> test event
    when you save the URL there -- it'll show up in Recent events below once it lands.
  </p>
  <label style="margin-top:0;">Webhook URL</label>
  <input type="text" value="<%= tebexWebhookUrl %>" readonly onclick="this.select()">
  <form method="post" action="/staff/tebex/settings" style="margin-top:14px; display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1; min-width:260px;">
      <label style="margin-top:0;">Webhook Signature Secret</label>
      <input type="text" name="webhookSecret" value="<%= tebexWebhookSecret || '' %>" placeholder="paste from Tebex's webhook settings" autocomplete="off">
    </div>
    <button class="btn btn-sm" type="submit">Save</button>
  </form>
  <p class="hint" style="margin-top:8px;">
    <% if (tebexWebhookSecret) { %>
      <span class="badge badge-open">Configured</span> incoming webhooks are verified against this secret.
    <% } else { %>
      <span class="badge badge-closed">Not set</span> every incoming webhook is rejected until this is saved.
    <% } %>
  </p>

  <hr class="card-divider">

  <h3 style="margin-top:0;">Preview as</h3>
  <p class="hint" style="margin-bottom:12px;">
    See the dashboard exactly as a given tier would -- which nav links and features show up -- without
    actually holding it. Only affects your own session; your real subscription (if any) is untouched.
    <% if (previewTierId) { %><strong>Currently previewing.</strong><% } %>
  </p>
  <div style="display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <form method="post" action="/staff/tebex/preview" style="display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div style="flex:1; min-width:200px;">
        <label style="margin-top:0;">Tier</label>
        <select name="tierId">
          <option value="">— Not previewing (my real subscription) —</option>
          <% tebexTiers.forEach(tier => { %>
            <option value="<%= tier.id %>" <%= previewTierId === tier.id ? 'selected' : '' %>><%= tier.name %></option>
          <% }) %>
        </select>
      </div>
      <button class="btn btn-sm" type="submit"><%= previewTierId ? 'Change preview' : 'Preview' %></button>
    </form>
    <% if (previewTierId) { %>
      <form method="post" action="/staff/tebex/preview">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm btn-ghost" type="submit">Stop previewing</button>
      </form>
    <% } %>
  </div>

  <hr class="card-divider">

  <h3>Tiers</h3>
  <p class="hint" style="margin-bottom:14px;">
    A tier matches on Tebex package ID -- whichever tier lists a package that shows up in a webhook's
    payload is what gets granted. If more than one tier somehow matches the same event, the higher-level
    one wins.
  </p>
  <% if (tebexTiers.length === 0) { %>
    <p class="empty">No tiers yet -- create one below.</p>
  <% } else { %>
    <% tebexTiers.forEach(tier => { %>
      <details class="role-panel" data-delete-item>
        <summary class="role-summary">
          <span class="role-summary-left">
            <svg class="role-chevron" width="10" height="10" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="role-summary-name"><%= tier.name %></span>
            <span class="role-summary-meta">level <%= tier.level %></span>
          </span>
          <span class="role-summary-right">
            <span class="badge"><%= tier.package_ids.length %> package ID<%= tier.package_ids.length === 1 ? '' : 's' %></span>
          </span>
        </summary>
        <div class="role-panel-body">
          <form method="post" action="/staff/tebex/tiers/<%= tier.id %>/save">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label style="margin-top:0;">Name</label>
            <input type="text" name="name" value="<%= tier.name %>" maxlength="100" required>

            <label style="margin-top:14px;">Level</label>
            <input type="number" name="level" value="<%= tier.level %>" min="0" step="1" style="max-width:120px;">
            <p class="hint" style="margin-top:4px;">Higher wins if two tiers ever match the same event.</p>

            <label style="margin-top:14px;">Tebex package IDs (one per line or comma-separated)</label>
            <textarea name="packageIds" rows="3" placeholder="123456&#10;123457"><%= tier.package_ids.join('\n') %></textarea>

            <label style="margin-top:14px;">Premium feature keys this tier unlocks (one per line or comma-separated)</label>
            <textarea name="features" rows="2" placeholder="custom_branding&#10;priority_support"><%= tier.features.join('\n') %></textarea>

            <div class="btn-row">
              <button class="btn btn-sm" type="submit">Save</button>
              <button class="btn btn-sm btn-danger js-pending-delete-btn" type="submit" formaction="/staff/tebex/tiers/<%= tier.id %>/delete">Delete tier</button>
            </div>
          </form>
        </div>
      </details>
    <% }) %>
  <% } %>

  <h3 style="margin-top:20px;">Create a tier</h3>
  <form method="post" action="/staff/tebex/tiers/create">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label style="margin-top:0;">Name</label>
    <input type="text" name="name" placeholder="e.g. Supporter" maxlength="100" required>

    <label style="margin-top:14px;">Level</label>
    <input type="number" name="level" value="0" min="0" step="1" style="max-width:120px;">

    <label style="margin-top:14px;">Tebex package IDs (one per line or comma-separated)</label>
    <textarea name="packageIds" rows="3" placeholder="123456"></textarea>

    <label style="margin-top:14px;">Premium feature keys this tier unlocks (one per line or comma-separated)</label>
    <textarea name="features" rows="2" placeholder="custom_branding"></textarea>

    <div class="btn-row">
      <button class="btn" type="submit">Create tier</button>
    </div>
  </form>

  <hr class="card-divider">

  <h3>Subscribers</h3>

  <form action="/staff/tebex/subscribers/grant" method="post" style="margin-bottom:16px;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Manually grant a tier</label>
    <p class="hint" style="margin:2px 0 8px;">
      Bypasses Tebex entirely -- for comps, an offline payment, or fixing a mismatch by hand. Leaving
      the server blank grants it unapplied, same as a fresh webhook (they'll be prompted to pick one
      on their Subscription page).
    </p>
    <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end;">
      <div>
        <label style="margin-top:0;">Discord user ID</label>
        <input type="text" name="discordUserId" placeholder="123456789012345678" required>
      </div>
      <div>
        <label style="margin-top:0;">Tier</label>
        <select name="tierId" required>
          <option value="" disabled selected>Choose a tier…</option>
          <% tebexTiers.forEach(t => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %>
        </select>
      </div>
      <div>
        <label style="margin-top:0;">Server (optional)</label>
        <select name="guildId">
          <option value="">Leave unapplied</option>
          <% guilds.forEach(g => { %><option value="<%= g.id %>"><%= g.name %></option><% }) %>
        </select>
      </div>
      <button class="btn" type="submit">Grant</button>
    </div>
  </form>

  <% if (tebexSubscribers.length === 0) { %>
    <p class="empty">No one's matched a webhook yet.</p>
  <% } else { %>
    <ul class="list">
      <% tebexSubscribers.forEach(s => { %>
        <li class="list-item">
          <div style="display:flex; align-items:center; gap:12px; min-width:0;">
            <% if (s.resolved) { %>
              <img src="<%= s.avatarURL %>" alt="" class="contact-avatar">
            <% } else { %>
              <span class="contact-avatar" style="display:flex; align-items:center; justify-content:center; font-size:11px; color:var(--text-muted);">?</span>
            <% } %>
            <div style="min-width:0;">
              <div class="list-item-title"><%= s.resolved ? s.tag : 'Unknown user' %></div>
              <div class="list-item-meta">
                <span class="contact-id" style="display:inline;"><%= s.discord_user_id %></span> ·
                <%= s.tierName || 'no tier' %> · <%= s.status %>
                <%= s.guild_id ? `· applied to ${guilds.find(g => g.id === s.guild_id)?.name || s.guild_id}` : (s.status === 'active' ? '· not applied to a server yet' : '') %>
                · <%= s.updated_at %>
              </div>
            </div>
          </div>
          <% if (s.status === 'active') { %>
            <div class="actions">
              <form action="/staff/tebex/subscribers/<%= s.discord_user_id %>/revoke" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-danger" type="submit">Revoke</button>
              </form>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <hr class="card-divider">

  <h3>Recent events</h3>
  <p class="hint" style="margin-bottom:12px;">
    Every webhook Tebex has sent, whether or not it matched anything -- useful for confirming the actual
    payload shape (field names can vary by store/platform type) once real deliveries start arriving.
  </p>
  <% if (tebexEvents.length === 0) { %>
    <p class="empty">Nothing received yet.</p>
  <% } else { %>
    <ul class="list">
      <% tebexEvents.forEach(e => { %>
        <li class="list-item" style="align-items:flex-start;">
          <div style="min-width:0; flex:1;">
            <div class="list-item-title">
              <%= e.type || '(no type)' %>
              <span class="badge <%= e.processed ? 'badge-open' : 'badge-closed' %>"><%= e.processed ? 'processed' : 'skipped' %></span>
            </div>
            <div class="list-item-meta"><%= e.note %> · <%= e.received_at %></div>
            <details style="margin-top:6px;">
              <summary style="cursor:pointer; color:var(--text-muted); font-size:12.5px;">Raw payload</summary>
              <pre style="white-space:pre-wrap; word-break:break-all; font-size:12px; margin-top:6px; background:var(--bg-input); border:1px solid var(--border); border-radius:7px; padding:10px;"><%= e.raw_json %></pre>
            </details>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
<% } %>

<% if (canSee('beta')) { %>
<div class="card" id="allowlist">
  <h2>Allowed Discord users</h2>
  <p class="hint" style="margin-bottom:14px;">
    Find a Discord user ID via Discord → User Settings → Advanced → enable Developer Mode,
    then right-click someone → Copy User ID. Or just approve their request from the DM you get
    when they click "Request access" on the login page.
  </p>

  <% if (allowlist.length === 0) { %>
    <p class="empty">No one's been added yet — only you can log in while closed beta is on.</p>
  <% } else { %>
    <ul class="list">
      <% allowlist.forEach(a => { %>
        <li class="list-item" data-delete-item>
          <div class="list-item-title"><%= a.discord_user_id %></div>
          <div class="actions">
            <form method="post" action="/staff/allowlist/remove" class="js-pending-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="discordUserId" value="<%= a.discord_user_id %>">
              <button class="btn btn-sm btn-danger" type="submit">Remove</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/staff/allowlist/add" style="margin-top:16px; display:flex; gap:10px; align-items:end;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1;">
      <label for="discordUserId" style="margin-top:0;">Discord user ID</label>
      <input type="text" id="discordUserId" name="discordUserId" placeholder="e.g. 1227918600753512480" pattern="\d{5,25}" required>
    </div>
    <button class="btn" type="submit">Add</button>
  </form>
</div>
<% } %>

<% if (canSee('blocklist')) { %>
<div class="card" id="blocklist">
  <h2>Global blocklist</h2>
  <p class="hint" style="margin-bottom:14px;">
    Blocks a Discord user bot-wide, across every server XyphrosMod is in — they're refused when opening a
    ticket, and auto-kicked the moment they join any server XyphrosMod manages. Separate from a single
    server's own ban list.
  </p>

  <% if (blocklist.length === 0) { %>
    <p class="empty">No one's blocked right now.</p>
  <% } else { %>
    <ul class="list">
      <% blocklist.forEach(b => { %>
        <li class="list-item" data-delete-item>
          <div class="list-item-title"><%= b.discord_user_id %></div>
          <div class="list-item-meta"><% if (b.reason) { %><%= b.reason %><% } %></div>
          <div class="actions">
            <form method="post" action="/staff/blocklist/remove" class="js-pending-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="discordUserId" value="<%= b.discord_user_id %>">
              <button class="btn btn-sm btn-danger" type="submit">Unblock</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/staff/blocklist/add" style="margin-top:16px; display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1; min-width:200px;">
      <label for="blockUserId" style="margin-top:0;">Discord user ID</label>
      <input type="text" id="blockUserId" name="discordUserId" placeholder="e.g. 1227918600753512480" pattern="\d{5,25}" required>
    </div>
    <div style="flex:1; min-width:200px;">
      <label for="blockReason" style="margin-top:0;">Reason (optional)</label>
      <input type="text" id="blockReason" name="reason" placeholder="e.g. raided a server" maxlength="200">
    </div>
    <button class="btn btn-danger" type="submit">Block</button>
  </form>
</div>
<% } %>

<% if (canSee('beta')) { %>
<div class="card" id="test-beta-dm">
  <h2>Test beta DMs</h2>
  <p class="hint" style="margin-bottom:14px;">
    See exactly what an approved and a declined beta access request DM look like — sends both, clearly
    marked as tests, straight to your own DMs. The real ones look identical, minus the test disclaimer.
  </p>
  <form method="post" action="/staff/test-beta-dm/send">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn" type="submit">Send test beta DMs to me</button>
  </form>
</div>
<% } %>

<% if (canSee('contacts') || canSee('emoji_book') || canSee('server_notes')) { %>
<h2 class="staff-group-heading">People &amp; servers</h2>
<% } %>

<% if (canSee('contacts')) { %>
<div class="card" id="contacts">
  <h2>Contacts</h2>
  <p class="hint" style="margin-bottom:14px;">
    Save people here once and pick them by name when sending a DM below — no more re-copying user IDs.
    Usernames and pictures are always pulled live from Discord, so they stay current on their own.
  </p>

  <% if (contacts.length === 0) { %>
    <p class="empty">No contacts saved yet — add one below.</p>
  <% } else { %>
    <ul class="list">
      <% contacts.forEach(c => { %>
        <li class="list-item" data-delete-item>
          <div style="display:flex; align-items:center; gap:12px; min-width:0;">
            <% if (c.resolved) { %>
              <img src="<%= c.avatarURL %>" alt="" class="contact-avatar">
            <% } else { %>
              <span class="contact-avatar" style="display:flex; align-items:center; justify-content:center; font-size:11px; color:var(--text-muted);">?</span>
            <% } %>
            <div style="min-width:0;">
              <div class="list-item-title"><%= c.resolved ? c.tag : 'Unknown user' %></div>
              <div class="list-item-meta">
                <span class="contact-id" style="display:inline;"><%= c.id %></span><% if (c.note) { %> · <%= c.note %><% } %><% if (!c.resolved) { %> · couldn't load from Discord<% } %>
              </div>
            </div>
          </div>
          <div class="actions">
            <form method="post" action="/staff/contacts/remove" class="js-pending-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="discordUserId" value="<%= c.id %>">
              <button class="btn btn-sm btn-danger" type="submit">Remove</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/staff/contacts/add" style="margin-top:16px; display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1; min-width:200px;">
      <label for="contactUserId" style="margin-top:0;">Discord user ID</label>
      <input type="text" id="contactUserId" name="discordUserId" placeholder="e.g. 1227918600753512480" pattern="\d{5,25}" required>
    </div>
    <div style="flex:1; min-width:200px;">
      <label for="contactNote" style="margin-top:0;">Note (optional)</label>
      <input type="text" id="contactNote" name="note" placeholder="e.g. Beta tester" maxlength="200">
    </div>
    <button class="btn" type="submit">Add contact</button>
  </form>
</div>
<% } %>

<% if (canSee('emoji_book')) { %>
<div class="card" id="emoji-book">
  <h2>Emoji book</h2>
  <p class="hint" style="margin-bottom:14px;">
    Save custom Discord emoji here once, so their markup is always one click away instead of re-typing
    <code>\:name:</code> in a server every time you need it. In Discord, type <code>\:name:</code> for the
    emoji you want and copy what it turns into — paste that below.
  </p>

  <% if (emojiBook.length === 0) { %>
    <p class="empty">No emoji saved yet — add one below.</p>
  <% } else { %>
    <ul class="list">
      <% emojiBook.forEach(e => { %>
        <li class="list-item" data-delete-item>
          <div style="display:flex; align-items:center; gap:12px; min-width:0;">
            <img src="https://cdn.discordapp.com/emojis/<%= e.emoji_id %>.<%= e.animated ? 'gif' : 'png' %>" alt="" class="contact-avatar" style="border-radius:8px; object-fit:contain; background:rgba(255,255,255,.04);">
            <div style="min-width:0;">
              <div class="list-item-title">:<%= e.name %>:</div>
              <div class="list-item-meta">
                <code class="emoji-markup"><%= e.markup %></code><% if (e.note) { %> · <%= e.note %><% } %>
              </div>
            </div>
          </div>
          <div class="actions">
            <button type="button" class="btn btn-sm btn-ghost" onclick="copyEmojiMarkup(this, <%= JSON.stringify(e.markup) %>)">Copy</button>
            <form method="post" action="/staff/emoji-book/remove" class="js-pending-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="id" value="<%= e.id %>">
              <button class="btn btn-sm btn-danger" type="submit">Remove</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/staff/emoji-book/add" style="margin-top:16px; display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1; min-width:220px;">
      <label for="emojiMarkup" style="margin-top:0;">Emoji markup</label>
      <input type="text" id="emojiMarkup" name="markup" placeholder="<:name:1234567890>" required>
    </div>
    <div style="flex:1; min-width:200px;">
      <label for="emojiNote" style="margin-top:0;">Note (optional)</label>
      <input type="text" id="emojiNote" name="note" placeholder="e.g. hype reaction" maxlength="200">
    </div>
    <button class="btn" type="submit">Add emoji</button>
  </form>
</div>
<% } %>

<% if (canSee('server_notes')) { %>
<div class="card" id="server-notes">
  <h2>Server notes</h2>
  <p class="hint" style="margin-bottom:14px;">
    A private note about a server, only visible here — never shown to that server. Useful for flagging
    one to watch closely, or just remembering why it's on the list.
  </p>

  <% if (serverNotesList.length === 0) { %>
    <p class="empty">No notes yet — add one below.</p>
  <% } else { %>
    <ul class="list">
      <% serverNotesList.forEach(n => { %>
        <li class="list-item" data-delete-item>
          <div>
            <div class="list-item-title"><%= n.guildName %></div>
            <div class="list-item-meta"><%= n.note %></div>
          </div>
          <div class="actions">
            <form method="post" action="/staff/server-notes/save" class="js-pending-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="guildId" value="<%= n.guild_id %>">
              <input type="hidden" name="note" value="">
              <button class="btn btn-sm btn-danger" type="submit">Clear</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/staff/server-notes/save" style="margin-top:16px; display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="flex:1; min-width:200px;">
      <label for="noteGuildId" style="margin-top:0;">Server</label>
      <select id="noteGuildId" name="guildId" required>
        <% guilds.forEach(g => { %><option value="<%= g.id %>"><%= g.name %></option><% }) %>
      </select>
    </div>
    <div style="flex:2; min-width:220px;">
      <label for="noteText" style="margin-top:0;">Note</label>
      <input type="text" id="noteText" name="note" placeholder="e.g. watch this one closely" maxlength="500" required>
    </div>
    <button class="btn" type="submit">Save note</button>
  </form>
</div>
<% } %>

<% if (canSee('dm_form') || canSee('send_dm') || canSee('broadcast') || canSee('maintenance')) { %>
<h2 class="staff-group-heading">Communication</h2>
<% } %>

<% if (canSee('dm_form')) { %>
<div class="card" id="dm-form">
  <h2>Application form templates</h2>
  <p class="hint" style="margin-bottom:14px;">
    Short forms you can send from a DM — never automatically, only when you send one yourself below. They
    get a button that opens a modal with your questions; the moment they submit, you get the answers by DM.
    Two starter templates are here to edit or delete as you like; add as many as you want.
  </p>

  <% if (templates.length === 0) { %>
    <p class="empty">No templates yet — create one below.</p>
  <% } else { %>
    <ul class="list">
      <% templates.forEach(t => { %>
        <li class="list-item" data-delete-item>
          <div>
            <div class="list-item-title"><%= t.name %></div>
            <div class="list-item-meta"><%= t.questions.length %> question<%= t.questions.length === 1 ? '' : 's' %></div>
          </div>
          <div class="actions">
            <button type="button" class="btn btn-sm btn-ghost" onclick="editDmFormTemplate(<%= t.id %>)">Edit</button>
            <form method="post" action="/staff/dm-form-templates/delete" class="js-pending-delete" style="display:inline;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="templateId" value="<%= t.id %>">
              <button class="btn btn-sm btn-danger" type="submit">Delete</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <h3 id="dmFormEditorTitle" style="margin-top:24px;">New template</h3>
  <form method="post" action="/staff/dm-form-templates/save" id="dmFormEditor">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="templateId" id="dmFormTemplateId" value="">

    <label for="dmFormName">Name (just for you)</label>
    <input type="text" id="dmFormName" name="name" placeholder="e.g. Team application" maxlength="100" required>

    <label for="dmFormTitle">Title (what they see)</label>
    <input type="text" id="dmFormTitle" name="title" placeholder="Request beta access" maxlength="200" required>

    <label for="dmFormIntro">Intro (optional)</label>
    <textarea id="dmFormIntro" name="intro" placeholder="A couple sentences shown above the button."></textarea>

    <label>Questions (up to 5)</label>
    <% for (let i = 1; i <= 5; i++) { %>
      <textarea name="question<%= i %>" id="dmFormQ<%= i %>" placeholder="Question <%= i %>" rows="2" style="margin-bottom:8px;"></textarea>
    <% } %>

    <div class="btn-row">
      <button class="btn" type="submit" id="dmFormSaveBtn">Create template</button>
      <button class="btn btn-ghost" type="button" id="dmFormCancelBtn" style="display:none;" onclick="resetDmFormTemplate()">Cancel edit</button>
    </div>
  </form>
</div>
<% } %>

<% if (canSee('send_dm')) { %>
<div class="card" id="send-dm">
  <h2>Send a DM as XyphrosMod</h2>
  <p class="hint" style="margin-bottom:14px;">
    Sends an embed straight to one or more people's DMs from the bot — pick any mix of saved contacts and
    pasted IDs, up to <%= 50 %> at once. Works for anyone XyphrosMod shares a server with (they need DMs from
    server members turned on); if a recipient can't be reached the rest still go out and you'll get told who failed.
  </p>
  <form method="post" action="/staff/send-dm" id="sendDmForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>Recipients</label>
    <% if (contacts.length === 0) { %>
      <p class="hint" style="margin-top:0;">No saved contacts yet — add some above, or just paste IDs below.</p>
    <% } else { %>
      <div style="display:flex; gap:10px; margin-bottom:6px;">
        <button type="button" class="btn btn-ghost btn-sm" id="contactsSelectAll">Select all</button>
        <button type="button" class="btn btn-ghost btn-sm" id="contactsSelectNone">Select none</button>
      </div>
      <div class="contact-picker">
        <% contacts.forEach(c => { %>
          <label class="contact-row">
            <input type="checkbox" name="contactIds" value="<%= c.id %>">
            <% if (c.resolved) { %>
              <img src="<%= c.avatarURL %>" alt="" class="contact-avatar">
            <% } else { %>
              <span class="contact-avatar" style="display:flex; align-items:center; justify-content:center; font-size:10px; color:var(--text-muted);">?</span>
            <% } %>
            <span style="min-width:0;">
              <span class="contact-name"><%= c.resolved ? c.tag : 'Unknown user' %></span>
              <span class="contact-id"><%= c.id %></span>
            </span>
          </label>
        <% }) %>
      </div>
    <% } %>

    <label for="dmExtraIds">Or paste more user IDs (comma or newline separated)</label>
    <textarea id="dmExtraIds" name="extraIds" placeholder="1227918600753512480, 998877665544332211" rows="2"></textarea>

    <label class="style-option" style="max-width:420px; margin-top:10px;">
      <input type="checkbox" name="saveNew" checked>
      <div>
        <div class="style-title">Save new IDs to contacts</div>
        <div class="style-desc">Anyone pasted above who isn't already saved gets added once the send succeeds.</div>
      </div>
    </label>

    <label for="dmTemplateId" style="margin-top:18px;">Attach a form instead (optional)</label>
    <select id="dmTemplateId" name="templateId">
      <option value="">— No form, just send the message below —</option>
      <% templates.forEach(t => { %>
        <option value="<%= t.id %>"><%= t.name %></option>
      <% }) %>
    </select>

    <div id="sendDmPlainFields">
      <label for="dmTitle">Title (optional)</label>
      <input type="text" id="dmTitle" name="title" placeholder="A message from the team">

      <label for="dmDescription">Message</label>
      <textarea id="dmDescription" name="description" required></textarea>

      <label for="dmColor">Color</label>
      <input type="color" id="dmColor" name="color" value="#a32ee2">
    </div>

    <div class="btn-row">
      <button class="btn" type="submit">Send</button>
    </div>
  </form>
</div>
<% } %>

<% if (canSee('broadcast')) { %>
<div class="card" id="broadcast">
  <h2>Broadcast to server owners</h2>
  <p class="hint" style="margin-bottom:14px;">
    Sends one embed to whoever owns every server XyphrosMod is in, all at once — for things like a planned
    downtime notice or a new-feature heads up. Skips any owner who can't be reached and tells you who.
  </p>
  <form method="post" action="/staff/broadcast-owners" onsubmit="return confirm('Send this to every server owner XyphrosMod has (' + <%= guilds.length %> + ' server<%= guilds.length === 1 ? "" : "s" %>)? There is no undo.');">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="broadcastTitle">Title (optional)</label>
    <input type="text" id="broadcastTitle" name="title" placeholder="A message from XyphrosMod">

    <label for="broadcastDescription">Message</label>
    <textarea id="broadcastDescription" name="description" required></textarea>

    <label for="broadcastColor">Color</label>
    <input type="color" id="broadcastColor" name="color" value="#a32ee2">

    <div class="btn-row">
      <button class="btn btn-danger" type="submit">Broadcast to all <%= guilds.length %> owner<%= guilds.length === 1 ? '' : 's' %></button>
    </div>
  </form>
</div>
<% } %>

<% if (canSee('maintenance')) { %>
<div class="card" id="maintenance">
  <h2>Maintenance banner</h2>
  <p class="hint" style="margin-bottom:14px;">
    A banner shown across every page of the dashboard (including the login page) while it's on — good for
    a heads-up before planned downtime or a risky change.
  </p>
  <form method="post" action="/staff/maintenance">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="style-option" style="max-width:420px;">
      <input type="checkbox" name="enabled" <%= settings.maintenanceEnabled ? 'checked' : '' %>>
      <div>
        <div class="style-title">Maintenance banner enabled</div>
        <div class="style-desc">Toggle on/off any time — the message below is remembered either way.</div>
      </div>
    </label>

    <label for="maintenanceMessage" style="margin-top:14px;">Banner message (optional)</label>
    <input type="text" id="maintenanceMessage" name="message" placeholder="e.g. Scheduled maintenance tonight 10pm–11pm UTC" maxlength="300" value="<%= settings.maintenanceMessage || '' %>">

    <div class="btn-row">
      <button class="btn" type="submit">Save</button>
    </div>
  </form>
</div>
<% } %>

<h2 class="staff-group-heading">Diagnostics</h2>

<div class="card" id="user-lookup">
  <h2>Global user lookup</h2>
  <p class="hint" style="margin-bottom:14px;">
    Paste a Discord user ID to see every server they're in, their warnings and mod actions across all of
    them, and whether they're a contact, allowlisted, blocklisted, or an admin.
  </p>

  <form method="get" action="/staff" id="userLookupForm" style="display:flex; gap:10px; align-items:end; flex-wrap:wrap;">
    <div style="flex:1; min-width:220px;">
      <label for="lookupId" style="margin-top:0;">Discord user ID</label>
      <input type="text" id="lookupId" name="lookupId" placeholder="e.g. 1227918600753512480" pattern="\d{5,25}" value="<%= lookup ? lookup.id : '' %>" required>
    </div>
    <button class="btn" type="submit">Look up</button>
  </form>

  <% if (lookup) { %>
    <div style="margin-top:20px;">
      <% if (lookup.error) { %>
        <p class="empty"><%= lookup.error %></p>
      <% } else { %>
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:14px;">
          <% if (lookup.user) { %>
            <img src="<%= lookup.user.avatarURL %>" alt="" class="contact-avatar">
            <div class="list-item-title"><%= lookup.user.tag %></div>
          <% } else { %>
            <div class="list-item-title">Unknown user (couldn't fetch from Discord)</div>
          <% } %>
        </div>
        <p class="list-item-meta" style="margin-bottom:14px;">
          <%= lookup.isContact ? '📇 Contact' : '' %>
          <%= lookup.isAllowlisted ? ' · ✅ Allowlisted' : '' %>
          <%= lookup.isBlocklisted ? ' · 🚫 Blocklisted' : '' %>
          <%= lookup.isAdmin ? ' · 🛡️ Admin' : '' %>
          <%= (!lookup.isContact && !lookup.isAllowlisted && !lookup.isBlocklisted && !lookup.isAdmin) ? 'No flags on this user.' : '' %>
        </p>

        <h3>Tebex subscription</h3>
        <% if (!lookup.tebex.subscriber) { %>
          <p class="empty" style="margin-bottom:14px;">
            No subscriber row for this exact Discord ID. If they say they bought something, check
            whether the Discord ID they typed at Tebex checkout actually matches this one -- that
            mismatch alone would explain everything looking "not applied."
          </p>
        <% } else { %>
          <p class="list-item-meta" style="margin-bottom:6px;">
            Tier: <strong><%= lookup.tebex.tier?.name || '(none -- tier was deleted)' %></strong>
            · Status: <strong><%= lookup.tebex.subscriber.status %></strong>
            · Reference: <span class="mono"><%= lookup.tebex.subscriber.tebex_reference || '(none)' %></span>
            · Updated: <%= lookup.tebex.subscriber.updated_at %>
          </p>
          <p class="list-item-meta" style="margin-bottom:6px;">
            <% if (!lookup.tebex.subscriber.guild_id) { %>
              ⚠️ Not applied to any server yet -- they need to pick one on their Subscription page
              (or grant it with a server pre-selected using the form above).
            <% } else { %>
              Applied to: <strong><%= lookup.tebex.appliedGuildName %></strong>
              (<span class="mono"><%= lookup.tebex.subscriber.guild_id %></span>)
              <% if (lookup.tebex.appliedGuildKnownToBot === false) { %>
                <br>⚠️ No bot (main or custom) currently knows about that server ID -- it may be
                stale, mistyped, or the bot was removed from it.
              <% } %>
            <% } %>
          </p>
          <p class="list-item-meta" style="margin-bottom:14px;">
            Tier's raw Features box: <span class="mono"><%= (lookup.tebex.tier?.features || []).join(', ') || '(empty)' %></span>
            · Has "custom_bot": <strong><%= lookup.tebex.hasCustomBot ? 'Yes' : 'No' %></strong>
          </p>
        <% } %>

        <h3>In <%= lookup.inGuilds.length %> server<%= lookup.inGuilds.length === 1 ? '' : 's' %></h3>
        <% if (lookup.inGuilds.length === 0) { %>
          <p class="empty">Not currently in any server XyphrosMod manages.</p>
        <% } else { %>
          <p class="list-item-meta" style="margin-bottom:14px;"><%= lookup.inGuilds.map(g => g.name).join(', ') %></p>
        <% } %>

        <h3>Warnings (<%= lookup.warnings.length %>)</h3>
        <% if (lookup.warnings.length === 0) { %>
          <p class="empty">None on record.</p>
        <% } else { %>
          <ul class="list">
            <% lookup.warnings.forEach(w => { %>
              <li class="list-item">
                <div>
                  <div class="list-item-title"><%= w.guildName %></div>
                  <div class="list-item-meta"><%= w.reason || '(no reason given)' %> · <%= w.created_at %></div>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <h3 style="margin-top:20px;">Mod actions (<%= lookup.modActions.length %>)</h3>
        <% if (lookup.modActions.length === 0) { %>
          <p class="empty">None on record.</p>
        <% } else { %>
          <ul class="list">
            <% lookup.modActions.forEach(m => { %>
              <li class="list-item">
                <div>
                  <div class="list-item-title"><%= m.action %> — <%= m.guildName %></div>
                  <div class="list-item-meta">by <%= m.moderator_tag || m.moderator_id %><% if (m.reason) { %> · <%= m.reason %><% } %> · <%= m.created_at %></div>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      <% } %>
    </div>
  <% } %>
</div>

<div class="card" id="audit-log">
  <h2>Admin action audit log</h2>
  <p class="hint" style="margin-bottom:14px;">
    Every add, remove, send, and leave any admin does in <code>/staff</code> — most recent first.
  </p>
  <% if (auditLog.length === 0) { %>
    <p class="empty">Nothing logged yet.</p>
  <% } else { %>
    <ul class="list">
      <% auditLog.forEach(l => { %>
        <li class="list-item">
          <div>
            <div class="list-item-title"><%= l.action %></div>
            <div class="list-item-meta">
              <%= l.actor_tag || l.actor_id %><% if (l.detail) { %> · <%= l.detail %><% } %> · <%= l.created_at %>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<% if (isOwner || canSee('remove_server')) { %>
<h2 class="staff-group-heading">System</h2>
<% } %>

<% if (isOwner) { %>
<div class="card" id="backup">
  <h2>Database backup</h2>
  <p class="hint" style="margin-bottom:14px;">
    Owner-only. Downloads a full, consistent snapshot of XyphrosMod's database right now — everything on
    this page plus every server's settings, tickets, tags, and logs. Good to grab before a risky change.
  </p>
  <a class="btn" href="/staff/backup">Download backup</a>
</div>
<% } %>

<% if (canSee('remove_server')) { %>
<div class="card" id="remove-server">
  <h2>Remove XyphrosMod from a server</h2>
  <p class="hint" style="margin-bottom:14px;">
    Search by server name, then leave it. There's no undo here — whoever wants XyphrosMod back has to re-invite it.
  </p>
  <label for="serverSearch">Search servers</label>
  <input type="text" id="serverSearch" placeholder="Start typing a server name…" autocomplete="off">
  <div id="serverResults" style="margin-top:10px;"></div>
</div>
<% } %>

<script>
(function () {
  var templates = <%- JSON.stringify(templates).replace(/</g, '\\u003c') %>;

  window.editDmFormTemplate = function (id) {
    var t = templates.find(function (x) { return x.id === id; });
    if (!t) return;
    document.getElementById('dmFormTemplateId').value = t.id;
    document.getElementById('dmFormName').value = t.name;
    document.getElementById('dmFormTitle').value = t.title;
    document.getElementById('dmFormIntro').value = t.intro || '';
    for (var i = 1; i <= 5; i++) {
      document.getElementById('dmFormQ' + i).value = t.questions[i - 1] || '';
    }
    document.getElementById('dmFormEditorTitle').textContent = 'Editing "' + t.name + '"';
    document.getElementById('dmFormSaveBtn').textContent = 'Save changes';
    document.getElementById('dmFormCancelBtn').style.display = '';
    document.getElementById('dmFormEditor').scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  window.resetDmFormTemplate = function () {
    document.getElementById('dmFormEditor').reset();
    document.getElementById('dmFormTemplateId').value = '';
    document.getElementById('dmFormEditorTitle').textContent = 'New template';
    document.getElementById('dmFormSaveBtn').textContent = 'Create template';
    document.getElementById('dmFormCancelBtn').style.display = 'none';
  };

  var templateSelect = document.getElementById('dmTemplateId');
  var plainFields = document.getElementById('sendDmPlainFields');
  var description = document.getElementById('dmDescription');
  if (templateSelect) {
    templateSelect.addEventListener('change', function () {
      var usingTemplate = !!templateSelect.value;
      plainFields.style.display = usingTemplate ? 'none' : '';
      description.required = !usingTemplate;
    });
  }

  window.copyEmojiMarkup = function (btn, markup) {
    navigator.clipboard.writeText(markup).then(function () {
      var original = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(function () { btn.textContent = original; }, 1500);
    }).catch(function () {});
  };

  var selectAllBtn = document.getElementById('contactsSelectAll');
  var selectNoneBtn = document.getElementById('contactsSelectNone');
  if (selectAllBtn) {
    selectAllBtn.addEventListener('click', function () {
      document.querySelectorAll('input[name="contactIds"]').forEach(function (cb) { cb.checked = true; });
    });
    selectNoneBtn.addEventListener('click', function () {
      document.querySelectorAll('input[name="contactIds"]').forEach(function (cb) { cb.checked = false; });
    });
  }
})();
</script>

<script>
(function () {
  var input = document.getElementById('serverSearch');
  var results = document.getElementById('serverResults');
  if (!input || !results) return; // hidden -- no "remove_server" staff access

  var guilds = <%- JSON.stringify(guilds).replace(/</g, '\\u003c') %>;
  var csrfToken = <%- JSON.stringify(csrfToken).replace(/</g, '\\u003c') %>;

  function row(g) {
    var li = document.createElement('li');
    li.className = 'list-item';

    var left = document.createElement('div');
    left.style.display = 'flex';
    left.style.alignItems = 'center';
    left.style.gap = '10px';
    if (g.iconURL) {
      var img = document.createElement('img');
      img.src = g.iconURL;
      img.alt = '';
      img.style.cssText = 'width:28px;height:28px;border-radius:50%;';
      left.appendChild(img);
    }
    var text = document.createElement('div');
    var title = document.createElement('div');
    title.className = 'list-item-title';
    title.textContent = g.name;
    var meta = document.createElement('div');
    meta.className = 'list-item-meta';
    meta.textContent = g.memberCount + ' member' + (g.memberCount === 1 ? '' : 's');
    text.appendChild(title);
    text.appendChild(meta);
    left.appendChild(text);

    var form = document.createElement('form');
    form.method = 'post';
    form.action = '/staff/leave-guild';
    form.onsubmit = function () {
      return confirm('Remove XyphrosMod from "' + g.name + '"? There\'s no undo here.');
    };
    var csrf = document.createElement('input');
    csrf.type = 'hidden'; csrf.name = '_csrf'; csrf.value = csrfToken;
    var gid = document.createElement('input');
    gid.type = 'hidden'; gid.name = 'guildId'; gid.value = g.id;
    var btn = document.createElement('button');
    btn.className = 'btn btn-sm btn-danger';
    btn.type = 'submit';
    btn.textContent = 'Leave';
    form.appendChild(csrf);
    form.appendChild(gid);
    form.appendChild(btn);

    li.appendChild(left);
    li.appendChild(form);
    return li;
  }

  function render(query) {
    results.innerHTML = '';
    var q = query.trim().toLowerCase();
    if (!q) return; // nothing shown until they actually search -- no crowded list

    var matches = guilds.filter(function (g) { return g.name.toLowerCase().indexOf(q) !== -1; }).slice(0, 8);
    if (matches.length === 0) {
      var empty = document.createElement('p');
      empty.className = 'empty';
      empty.textContent = 'No servers match "' + query + '".';
      results.appendChild(empty);
      return;
    }

    var list = document.createElement('ul');
    list.className = 'list';
    matches.forEach(function (g) { list.appendChild(row(g)); });
    results.appendChild(list);
  }

  input.addEventListener('input', function () { render(input.value); });
})();
</script>

<script>
(function () {
  if (location.search.indexOf('lookupId') === -1) return;
  var el = document.getElementById('user-lookup');
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
})();
</script>

