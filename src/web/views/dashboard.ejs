<%- include('partials/header', { title: 'Servers' }) %>
<h1>Your servers</h1>
<p class="subtitle">
  <% if (!botReady) { %>
    The bot is still connecting to Discord. Refresh in a few seconds.
  <% } else { %>
    Servers Quellum is in that you manage.
  <% } %>
</p>

<% if (guilds.length === 0) { %>
  <div class="card empty">
    Quellum isn't in any of your servers yet — hit <strong>Invite to Server</strong> above to add it.
  </div>
<% } else { %>
  <div class="guild-grid">
    <% guilds.forEach(g => { %>
      <a class="guild-card" href="/dashboard/<%= g.id %>/tickets">
        <img src="<%= g.iconURL || 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22/%3E' %>" alt="">
        <div class="guild-card-name"><%= g.name %></div>
        <div class="guild-card-meta">
          <% if (g.memberCount !== null) { %><span><%= g.memberCount.toLocaleString() %> members</span><% } %>
          <% if (g.openTickets > 0) { %><span class="guild-card-tickets"><%= g.openTickets %> open ticket<%= g.openTickets === 1 ? '' : 's' %></span><% } %>
        </div>
      </a>
    <% }) %>
  </div>
  <script>
  (function () {
    document.querySelectorAll('.guild-card').forEach(function (card) {
      card.addEventListener('click', function (e) {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return; // let open-in-new-tab work normally
        e.preventDefault();
        var href = card.getAttribute('href');
        var splash = document.createElement('div');
        splash.className = 'quellum-splash';
        splash.innerHTML = '<img src="/img/quellum-logo-impact.svg" alt="" width="130" height="130">';
        document.body.appendChild(splash);
        setTimeout(function () { window.location.href = href; }, 1000);
      });
    });
  })();
  </script>
<% } %>
<%- include('partials/footer') %>
