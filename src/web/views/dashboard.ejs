<%- include('partials/header', { title: 'Servers' }) %>
<h1>Your servers</h1>
<p class="subtitle">
  <% if (!botReady) { %>
    The bot is still connecting to Discord. Refresh in a few seconds.
  <% } else { %>
    Servers XyphrosMod is in that you manage.
  <% } %>
</p>

<button type="button" id="replayTourBtn" class="btn btn-ghost btn-sm" style="margin-bottom:20px;">Take the tour</button>
<button type="button" id="replayIntroBtn" class="btn btn-ghost btn-sm" style="margin-bottom:20px; margin-left:10px;">Watch intro video</button>

<% if (guilds.length === 0) { %>
  <div class="card empty">
    XyphrosMod isn't in any of your servers yet — hit <strong>Invite to Server</strong> above to add it.
  </div>
<% } else { %>
  <div class="guild-grid">
    <% guilds.forEach(g => { %>
      <a class="guild-card" href="/dashboard/<%= g.id %>/overview">
        <img src="<%= g.iconURL || 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22/%3E' %>" alt="">
        <div class="guild-card-name"><%= g.name %></div>
        <div class="guild-card-meta">
          <% if (g.memberCount !== null) { %><span><%= g.memberCount.toLocaleString() %> members</span><% } %>
          <% if (g.openTickets > 0) { %><span class="guild-card-tickets"><%= g.openTickets %> open ticket<%= g.openTickets === 1 ? '' : 's' %></span><% } %>
          <% if (g.warningsToday > 0) { %><span class="guild-card-warnings"><%= g.warningsToday %> warning<%= g.warningsToday === 1 ? '' : 's' %> today</span><% } %>
        </div>
      </a>
    <% }) %>
  </div>
  <script>
  (function () {
    document.querySelectorAll('.guild-card').forEach(function (card) {
      card.addEventListener('click', function (e) {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return; // let open-in-new-tab work normally
        e.preventDefault();
        var href = card.getAttribute('href');
        var splash = document.createElement('div');
        splash.className = 'xyphros-splash';
        splash.innerHTML = '<img src="/img/xyphros-logo-impact.gif" alt="" width="130" height="130">';
        document.body.appendChild(splash);
        setTimeout(function () { window.location.href = href; }, 1000);
      });
    });
  })();
  </script>
<% } %>

<script src="/js/tour.js"></script>
<script>
(function () {
  var SEEN_INTRO_VIDEO = 'xyphrosIntroVideoSeen';
  var SEEN_SERVER_LIST = 'xyphrosTourServerListSeen';
  var SEEN_GUILD_NAV = 'xyphrosTourGuildNavSeen';

  var STEPS = [
    { title: 'Welcome to XyphrosMod', body: "A 30-second look around the dashboard. Skip any time -- Take the tour on this page brings it back later." },
    { selector: '.guild-grid', title: 'Your servers', body: 'Every server you manage shows up here. Click one to open its dashboard -- tickets, moderation, settings, all of it.' },
    { selector: '#tourInviteBtn', title: 'Add XyphrosMod somewhere new', body: 'Invite the bot to another server you manage, any time.' },
    { selector: '#tourAdminBtn', title: 'Staff tools', body: "Closed beta settings, DMs, and server management for the whole install -- only owners and admins see this." },
  ];

  function startTour() {
    new XyphrosModTour(STEPS, {
      onEnd: function () {
        try { localStorage.setItem(SEEN_SERVER_LIST, '1'); } catch (e) {}
      },
    }).start();
  }

  function maybeStartTour() {
    var seen = false;
    try { seen = !!localStorage.getItem(SEEN_SERVER_LIST); } catch (e) {}
    if (!seen) setTimeout(startTour, 900);
  }

  function showIntroVideo(done) {
    var overlay = document.createElement('div');
    overlay.className = 'xyphros-intro-overlay';

    var box = document.createElement('div');
    box.className = 'xyphros-intro-box';

    var head = document.createElement('div');
    head.className = 'xyphros-intro-head';
    var title = document.createElement('div');
    title.className = 'xyphros-intro-title';
    title.textContent = 'Welcome to XyphrosMod';
    var skipBtn = document.createElement('button');
    skipBtn.type = 'button';
    skipBtn.className = 'btn btn-ghost btn-sm';
    skipBtn.textContent = 'Skip intro';
    head.appendChild(title);
    head.appendChild(skipBtn);

    var video = document.createElement('video');
    video.src = '/video/xyphros-intro.mp4';
    video.controls = true;
    video.playsInline = true;
    video.autoplay = true;
    video.muted = true; // no audio track on this clip, but muted keeps autoplay reliable regardless

    box.appendChild(head);
    box.appendChild(video);
    overlay.appendChild(box);
    document.body.appendChild(overlay);

    var finished = false;
    function close() {
      if (finished) return;
      finished = true;
      try { localStorage.setItem(SEEN_INTRO_VIDEO, '1'); } catch (e) {}
      overlay.remove();
      done();
    }
    video.addEventListener('ended', close);
    skipBtn.addEventListener('click', close);
  }

  var replayBtn = document.getElementById('replayTourBtn');
  if (replayBtn) {
    replayBtn.addEventListener('click', function () {
      try { localStorage.removeItem(SEEN_SERVER_LIST); localStorage.removeItem(SEEN_GUILD_NAV); } catch (e) {}
      startTour();
    });
  }

  var replayIntroBtn = document.getElementById('replayIntroBtn');
  if (replayIntroBtn) {
    replayIntroBtn.addEventListener('click', function () {
      showIntroVideo(function () {});
    });
  }

  var introSeen = false;
  try { introSeen = !!localStorage.getItem(SEEN_INTRO_VIDEO); } catch (e) {}
  if (!introSeen) {
    showIntroVideo(maybeStartTour);
  } else {
    maybeStartTour();
  }
})();
</script>
<%- include('partials/footer') %>
