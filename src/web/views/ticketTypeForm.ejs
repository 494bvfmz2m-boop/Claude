<%- include('partials/header', { title: ticketType ? 'Edit ticket type' : 'New ticket type', guild }) %>
<h1><%= ticketType ? 'Edit ticket type' : 'New ticket type' %></h1>
<p class="subtitle">Defines a category of ticket: where its channel goes, who gets access, and its welcome message.</p>

<form class="card" method="post" action="<%= ticketType ? `/dashboard/${guild.id}/ticket-types/${ticketType.id}` : `/dashboard/${guild.id}/ticket-types` %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div style="display:flex; gap:10px; align-items:center; margin-bottom:20px;">
    <select id="ticketTypeTemplate" style="flex:1;">
      <option value="">— Load a starter template (optional) —</option>
      <option value="support">General Support</option>
      <option value="bug">Bug Report</option>
      <option value="billing">Billing</option>
      <option value="appeal">Ban Appeal</option>
    </select>
    <button type="button" id="loadTicketTemplate" class="btn btn-ghost btn-sm">Load</button>
  </div>

  <div class="grid">
    <div>
      <label for="name">Name</label>
      <input type="text" id="name" name="name" value="<%= ticketType?.name || '' %>" placeholder="General Support" required>
    </div>
    <div>
      <label for="emoji">Emoji (optional)</label>
      <input type="text" id="emoji" name="emoji" value="<%= ticketType?.emoji || '' %>" placeholder="🎫">
    </div>
  </div>

  <label for="categoryChannelId">Discord category channel for new tickets</label>
  <select id="categoryChannelId" name="categoryChannelId">
    <option value="">— None (created at top level) —</option>
    <% options.categories.forEach(c => { %>
      <option value="<%= c.id %>" <%= ticketType?.category_channel_id === c.id ? 'selected' : '' %>><%= c.name %></option>
    <% }) %>
  </select>

  <label>Support role(s) who can see & manage these tickets</label>
  <div class="role-picker">
    <% options.roles.forEach(r => { %>
      <label class="role-chip" style="--role-color: <%= r.color %>">
        <input type="checkbox" name="supportRoleIds" value="<%= r.id %>" <%= ticketType?.support_role_ids?.includes(r.id) ? 'checked' : '' %>>
        <% if (r.iconURL) { %>
          <img class="role-icon" src="<%= r.iconURL %>" alt="">
        <% } else if (r.unicodeEmoji) { %>
          <span><%= r.unicodeEmoji %></span>
        <% } else { %>
          <span class="role-dot"></span>
        <% } %>
        <%= r.name %>
      </label>
    <% }) %>
  </div>
  <div class="hint">Click to toggle. Colors and icons match how each role looks in Discord.</div>

  <div class="grid">
    <div>
      <label for="namePattern">Ticket channel name pattern</label>
      <input type="text" id="namePattern" name="namePattern" value="<%= ticketType?.name_pattern || 'ticket-{username}' %>">
      <div class="hint">Use <code>{username}</code> or <code>{id}</code>.</div>
    </div>
    <div>
      <label for="maxOpenPerUser">Max open tickets per user (this type)</label>
      <input type="number" id="maxOpenPerUser" name="maxOpenPerUser" min="1" value="<%= ticketType?.max_open_per_user || 1 %>">
    </div>
  </div>

  <label for="welcomeTitle">Welcome embed title</label>
  <input type="text" id="welcomeTitle" name="welcomeTitle" value="<%= ticketType?.welcome_title || '' %>" placeholder="General Support ticket">

  <label for="welcomeDescription">Welcome embed description</label>
  <textarea id="welcomeDescription" name="welcomeDescription" placeholder="Thanks for reaching out! Support will be with you shortly."><%= ticketType?.welcome_description || '' %></textarea>
  <%- include('partials/mentionTools', { targetId: 'welcomeDescription', roles: options.roles, guildId: guild.id }) %>
  <div class="hint">Mentions only render in the description here — not the title.</div>

  <label for="welcomeColor">Welcome embed color</label>
  <input type="color" id="welcomeColor" name="welcomeColor" value="<%= ticketType?.welcome_color || '#a32ee2' %>">

  <label class="role-chip" style="--role-color: #5865F2; margin-top:20px; width:fit-content;">
    <input type="checkbox" name="generateTranscript" <%= (ticketType ? ticketType.generate_transcript : true) ? 'checked' : '' %>>
    Generate a transcript when tickets of this type close
  </label>
  <div class="hint">
    Turn this off for anything that might contain sensitive info (billing, appeals, etc.) — the ticket still
    gets logged in the ticket log channel, just without an attached transcript file.
  </div>

  <div class="btn-row">
    <button class="btn" type="submit"><%= ticketType ? 'Save changes' : 'Create ticket type' %></button>
    <a class="btn btn-ghost" href="/dashboard/<%= guild.id %>/tickets">Cancel</a>
  </div>
</form>
<script src="/js/mentionInsert.js"></script>
<script>
(function () {
  var TEMPLATES = {
    support: {
      name: 'General Support', emoji: '🎫', welcomeTitle: 'General Support ticket',
      welcomeDescription: "Thanks for reaching out! Describe your issue below and a member of the team will be with you shortly.",
      welcomeColor: '#a32ee2',
    },
    bug: {
      name: 'Bug Report', emoji: '🐛', welcomeTitle: 'Bug Report',
      welcomeDescription: 'Thanks for the report! Please include steps to reproduce, what you expected to happen, and what happened instead.',
      welcomeColor: '#ed4245',
    },
    billing: {
      name: 'Billing', emoji: '💳', welcomeTitle: 'Billing support',
      welcomeDescription: 'A member of the billing team will be with you shortly. Please have your order or transaction details ready.',
      welcomeColor: '#23a55a',
    },
    appeal: {
      name: 'Ban Appeal', emoji: '⚖️', welcomeTitle: 'Ban appeal',
      welcomeDescription: 'Explain why you believe this action should be reconsidered. Appeals are reviewed by staff — please be honest and respectful.',
      welcomeColor: '#f2c078',
    },
  };

  var select = document.getElementById('ticketTypeTemplate');
  var loadBtn = document.getElementById('loadTicketTemplate');
  if (!select || !loadBtn) return;

  loadBtn.addEventListener('click', function () {
    var t = TEMPLATES[select.value];
    if (!t) return;
    document.getElementById('name').value = t.name;
    document.getElementById('emoji').value = t.emoji;
    document.getElementById('welcomeTitle').value = t.welcomeTitle;
    document.getElementById('welcomeDescription').value = t.welcomeDescription;
    document.getElementById('welcomeColor').value = t.welcomeColor;
  });
})();
</script>
<%- include('partials/footer') %>
