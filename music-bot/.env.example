# --- Discord ---
# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (General Information page)
CLIENT_ID=
# Optional: register commands to one server instantly (leave empty for global commands, which can take up to an hour)
GUILD_ID=

# --- Lavalink (audio server) ---
# Use http://lavalink:2333 when running with docker compose, http://localhost:2333 otherwise
LAVALINK_URL=http://localhost:2333
LAVALINK_PASSWORD=youshallnotpass

# --- Behaviour ---
# Search prefix used for plain-text queries: ytsearch, ytmsearch, scsearch, spsearch (needs Spotify enabled)
DEFAULT_SEARCH=ytmsearch
# Seconds to wait in an empty / idle channel before leaving (ignored in 24/7 mode)
IDLE_TIMEOUT=180
DEFAULT_VOLUME=80

# --- Optional sources (read by Lavalink via docker compose) ---
# Spotify links: create an app at https://developer.spotify.com/dashboard
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Apple Music links
APPLEMUSIC_ENABLED=false
APPLEMUSIC_MEDIA_API_TOKEN=
