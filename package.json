{
  "name": "ticket-auto-reply-bot",
  "version": "1.0.0",
  "description": "Discord bot that auto-answers ticket-channel questions from a keyword-matched FAQ database, with a web dashboard, and escalates to a support role when it can't help.",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register-commands": "node src/discord/deploy-commands.js",
    "hash-password": "node scripts/hash-password.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
