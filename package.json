{
  "name": "discord-management-bot",
  "version": "1.0.0",
  "description": "All-in-one Discord bot: moderation, tickets, anti-raid, giveaways, join/leave logs, automatic order embeds, and a secure web dashboard.",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
    "dashboard": "node dashboard/server.js",
    "dev": "concurrently -n bot,dashboard -c blue,green \"node src/index.js\" \"node dashboard/server.js\"",
    "hash-password": "node scripts/hash-password.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
